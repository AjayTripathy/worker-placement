  "claims": [
    {
      "claim_id": "C1",
      "claim_text": "United Airlines Ventures, Ltd. invested $15.0 million in Eve in September 2022 via a subscription for 2,039,353 shares of common stock plus warrants to acquire up to 2,722,536 shares with $0.01 exercise price.",
      "subject": "Eve Holding, Inc.",
      "predicate": "received_investment_from",
      "object_value": "United Airlines Ventures, Ltd. ($15.0M cash + warrants for 2,722,536 shares)",
      "source_quote": "in September 2022, Eve received $15.0 million from United Airlines Ventures, Ltd. (United), in connection with a subscription agreement pursuant to which United agreed to subscribe for an aggregate of 2,039,353 shares of common stock and a warrant agreement pursuant to which the Company issued to United new warrants to acquire up to 2,722,536 shares of common stock, each with an exercise price of $0.01 per share.",
      "category": "named_counterparty_investment"
    },
    {
      "claim_id": "C2",
      "claim_text": "Eve has established an initial order pipeline of 2,850 vehicles valued at $8.6 billion from 29 launch customers (acknowledged as non-binding LOIs).",
      "subject": "Eve Holding, Inc.",
      "predicate": "has_order_pipeline_from",
      "object_value": "2,850 eVTOLs / $8.6B / 29 launch customers (non-binding)",
      "source_quote": "To date, we have established an initial order pipeline of 2,850 vehicles valued at $8.6 billion from 29 launch customers. Our initial order pipeline is based on non-binding agreements and therefore subject to material change, consistent with common aviation practices.",
      "category": "order_pipeline"
    },
    {
      "claim_id": "C3",
      "claim_text": "Eve operates from Melbourne, Florida (alongside Embraer) as one of two principal locations; the eVTOL is being developed at this aerospace facility.",
      "subject": "Eve Holding, Inc.",
      "predicate": "operates_facility_in",
      "object_value": "Melbourne, Florida (US aviation facility)",
      "source_quote": "Eve Holding, Inc., a Delaware corporation, is an aerospace company with operations in Melbourne, Florida and Brazil.",
      "category": "facility_location"
    },
    {
      "claim_id": "C4",
      "claim_text": "Eve's parent and strategic partner Embraer S.A. (ERJ) entered a 15-year Master Service Agreement and Shared Service Agreement under which Eve has access to Embraer's R&D, engineering, manufacturing facilities and IP on a royalty-free basis. Embraer charged Eve $75.8 million in related party expenses in 2023 (R&D $72.8M + SG&A $3.0M).",
      "subject": "Eve Holding, Inc.",
      "predicate": "owes_payable_to_vendor",
      "object_value": "Embraer S.A. (parent, NYSE ADR, CIK 0001355856) - $75.8M related party expense FY2023",
      "source_quote": "In December 2021, Eve and Embraer entered into the Master Service Agreement and Shared Service Agreement... The MSA established a fee so that Eve may have access to Embraer's R&D and engineering department structure... Related Party Expenses... 2023 Research and development $ 72,768 Selling, general and administrative 3,032 Total $ 75,800",
      "category": "vendor_relationship"
    },
    {
      "claim_id": "C5",
      "claim_text": "Eve has a portfolio of intellectual property in eVTOL / urban air mobility (positions itself as having proprietary tech and IP portfolio sufficient to compete globally).",
      "subject": "Eve Holding, Inc.",
      "predicate": "has_patent_portfolio_in",
      "object_value": "eVTOL / urban air mobility / electric aircraft / urban air traffic management",
      "source_quote": "We believe we are uniquely positioned to develop, certify and commercialize our UAM solution on a global scale given our aviation heritage, our strategic relationship with Embraer S.A.... our technology and intellectual property portfolio and the experience of our management team and employees, among other factors.",
      "category": "intellectual_property"
    },
    {
      "claim_id": "C6",
      "claim_text": "Eve is reliant on a related party loan from Embraer Aircraft Holding (EAH) of up to $81 million in aggregate principal at 5.97% (loan receivable from EAH of $83.1M as of Dec 31, 2023, with renewal extending term to August 2024). Eve also drew $26.1M of $101.2M BNDES facility (Brazilian National Development Bank) for green-loan eVTOL development.",
      "subject": "Eve Holding, Inc.",
      "predicate": "has_related_party_loan_with",
      "object_value": "$83.1M receivable from EAH (related party); $26.1M outstanding under BNDES R$490M facility",
      "source_quote": "On August 1, 2023, Eve and EAH agreed to amend the Loan Agreement (\"Amended Loan Agreement\") to extend the term an additional 12 months to August 1, 2024 and increase the fixed interest rate to 5.97% per annum. The aggregate principal amount is still up to $81 million... As of December 31, 2023, Eve had cash of $46.9 million, investments in marketable securities of $111.2 million and a related party loan receivable of $83.1 million from EAH.",
      "category": "financial_distress"
    },
    {
      "claim_id": "C7",
      "claim_text": "Eve expects to reach entry-into-service for its eVTOL aircraft in the latter half of 2026 (FAA / global certification claim).",
      "subject": "Eve Holding, Inc.",
      "predicate": "projects_entry_into_service",
      "object_value": "eVTOL EIS = H2 2026",
      "source_quote": "We currently expect to reach entry-into-service in the latter half of 2026.",
      "category": "regulatory_certification_projection"
    }
  ],
