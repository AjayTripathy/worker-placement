  "claims": [
    {
      "claim_id": "C1",
      "claim_text": "We have already started executing our sales strategy through our partnerships with American Airlines, Avolon, Bristow, Iberojet, Marubeni, Virgin Atlantic, Babcock International, FLYINGGROUP and Kakao Mobility. We have also received conditional pre-orders and pre-order options, including from American Airlines.",
      "subject": "Vertical Aerospace VX4 eVTOL",
      "predicate": "has_pre_order_from",
      "object_value": "American Airlines",
      "source_quote": "We have already started executing our sales strategy through our partnerships with American Airlines, Avolon, Bristow, Iberojet, Marubeni, Virgin Atlantic ... We have also received conditional pre-orders and pre-order options, including from American Airlines, Avolon, Bristow, Iberojet, Virgin Atlantic and Marubeni",
      "category": "named_counterparty"
    },
    {
      "claim_id": "C2",
      "claim_text": "Pre-orders from Avolon (aircraft leasing).",
      "subject": "Vertical Aerospace VX4 eVTOL",
      "predicate": "has_pre_order_from",
      "object_value": "Avolon",
      "source_quote": "We have also received conditional pre-orders and pre-order options, including from American Airlines, Avolon, Bristow, Iberojet, Virgin Atlantic and Marubeni",
      "category": "named_counterparty"
    },
    {
      "claim_id": "C3",
      "claim_text": "In collaboration with Microsoft, we have created a Vertical Cloud to host aircraft data.",
      "subject": "Vertical Aerospace",
      "predicate": "has_partnership_with",
      "object_value": "Microsoft",
      "source_quote": "In collaboration with Microsoft, we have created a Vertical Cloud to host aircraft data and will be leveraging this to provide aircraft equipment health monitoring",
      "category": "named_counterparty"
    },
    {
      "claim_id": "C4",
      "claim_text": "We have partnered with Syensqo and Leonardo, global leaders in composite materials in aerospace.",
      "subject": "Vertical Aerospace VX4",
      "predicate": "has_supply_partnership_with",
      "object_value": "Leonardo (composites)",
      "source_quote": "We have partnered with Syensqo and Leonardo, global leaders in composite materials in aerospace, to incorporate lightweight composite materials",
      "category": "named_counterparty"
    },
    {
      "claim_id": "C5",
      "claim_text": "We are designing our aircraft with a focus on manufacturing and the fastest route to scale from day one. We will be responsible for the overall manufacture and assembly of the aircraft and battery system. We lease approximately 15,000 square feet located at Severn Road, Avonmouth, Bristol, England for a battery testing facility.",
      "subject": "Vertical Aerospace",
      "predicate": "operates_manufacturing_facility_at",
      "object_value": "Bristol/Kemble/Avonmouth UK",
      "source_quote": "We are headquartered in Bristol, England ... Our facility in Bristol is leased from a third party for a term of ten years expiring in 2028 ... We have a dedicated flight test centre located at Cotswold Airport, Kemble ... We lease approximately 15,000 square feet located at Severn Road, Avonmouth, Bristol, England for a battery testing facility",
      "category": "factory_claim"
    },
    {
      "claim_id": "C6",
      "claim_text": "Our in-house expertise covers design, certification, assembly and manufacture, pilot experience, end-user experience and base platform performance. The VX4 aircraft is being designed around existing certifiable technology, as well as certain novel technology such as the batteries and powertrain.",
      "subject": "Vertical Aerospace",
      "predicate": "holds_patent_portfolio_in",
      "object_value": "battery, powertrain, eVTOL",
      "source_quote": "One of the most critical components of the VX4 is our battery system, which is being designed in-house, given the unique requirements for eVTOL battery systems ... we are currently undertaking [smart charging and advanced battery health diagnostics research]",
      "category": "ip_portfolio"
    },
    {
      "claim_id": "C7",
      "claim_text": "On February 22, 2024 we entered into the SF Investment Agreement with Imagination Aero, a company wholly owned by Stephen Fitzpatrick, our majority shareholder, Chief Executive Officer and a member of our board of directors, pursuant to which Imagination Aero agreed to purchase up to $50 million.",
      "subject": "Vertical Aerospace",
      "predicate": "received_related_party_financing_from",
      "object_value": "Imagination Aero (Stephen Fitzpatrick) - $50M committed, $25M received Mar 13, 2024",
      "source_quote": "On February 22, 2024 we entered into the SF Investment Agreement with Imagination Aero, a company wholly owned by Stephen Fitzpatrick, our majority shareholder, Chief Executive Officer and a member of our board of directors ... Imagination Aero agreed to purchase, and we agreed to issue and sell to Imagination Aero, up to $50 million",
      "category": "financial_distress"
    },
    {
      "claim_id": "C8",
      "claim_text": "Together with other partners including Ferrovial, with whom we are cooperating to create a network of 25 vertiports in the UK.",
      "subject": "Vertical Aerospace",
      "predicate": "has_partnership_with",
      "object_value": "Ferrovial - 25 UK vertiports",
      "source_quote": "Together with other partners including Ferrovial, with whom we are cooperating to create a network of 25 vertiports in the UK",
      "category": "named_counterparty"
    }
  ],
