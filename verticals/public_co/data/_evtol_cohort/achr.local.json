  "claims": [
    {
      "claim_id": "achr_united_purchase_agreement",
      "claim_text": "Archer has entered into a purchase agreement with United Airlines, Inc. for the conditional purchase of up to $1.0 billion worth of aircraft, with an option for another $500.0 million. United paid $10.0 million in pre-delivery payments in August 2022 for 100 aircraft.",
      "subject": "Archer Aviation",
      "predicate": "has_purchase_agreement_with",
      "object_value": "United Airlines (UAL) - $1.0B base + $500M option, $10M pre-delivery payment",
      "source_quote": "We have entered into a purchase agreement with United Airlines Inc. ( United ) for the conditional purchase of up to $1.0 billion worth of aircraft, with an option for another $500.0 million worth of aircraft (as amended, the United Purchase Agreement ). ... in August 2022, United paid us $10.0 million in pre-delivery payments for 100 aircraft covered under our purchase agreement.",
      "category": "named_counterparty"
    },
    {
      "claim_id": "achr_stellantis_partnership",
      "claim_text": "Archer has a strategic manufacturing partnership with Stellantis N.V. as contract manufacturer for its Midnight aircraft, and Stellantis has invested via a Forward Purchase Agreement, including drawdowns of $95.0 million in 2023.",
      "subject": "Archer Aviation",
      "predicate": "has_manufacturing_partnership_with",
      "object_value": "Stellantis N.V. - contract manufacturer + Forward Purchase Agreement equity investment",
      "source_quote": "we plan to work alongside Stellantis N.V. ( Stellantis ) on the build out and stand up this facility and our operations there. ... The goal over the long term is for Stellantis to mass produce our eVTOL aircraft as our contract manufacturer. ... In 2023, we drew down on $95.0 million of funding available under our strategic funding agreement",
      "category": "named_counterparty"
    },
    {
      "claim_id": "achr_boeing_wisk_settlement",
      "claim_text": "On August 10, 2023, Archer, Boeing and Wisk entered into Technology and Dispute Resolution Agreements providing for Boeing investment in Archer Class A common stock and an autonomous-flight-tech collaboration with Wisk; Archer issued Wisk a warrant for up to 13,176,895 shares.",
      "subject": "Archer Aviation",
      "predicate": "has_settlement_and_investment_with",
      "object_value": "Boeing (BA) - PIPE investment; Wisk - 13.18M-share warrant",
      "source_quote": "On August 10, 2023, the Company, Boeing and Wisk entered into a series of agreements that provide for, among other things, for certain investments by Boeing into the Company and an autonomous flight technology collaboration between Wisk and the Company, the issuance of certain warrants to Wisk and resolution of the federal and state court litigation between the parties",
      "category": "named_counterparty"
    },
    {
      "claim_id": "achr_covington_factory_ga",
      "claim_text": "Archer has begun build-out of a 350,000 sq-ft high-volume manufacturing facility in Covington, Georgia, designed to produce up to 650 aircraft per year, with target substantial completion of phase 1 in 2024.",
      "subject": "Archer Aviation",
      "predicate": "operates_facility_in",
      "object_value": "Covington, Georgia - 350,000 sq-ft manufacturing plant under construction",
      "source_quote": "we completed the build out of a production facility in San Jose, California ... as well as a high-volume production facility in Covington, Georgia. We have begun our Covington facility build-out and target substantial completion of the first phase in 2024, which is a 350,000 square-foot facility that is designed to be capable of supporting production of up to 650 aircraft per year.",
      "category": "facility_existence"
    },
    {
      "claim_id": "achr_san_jose_production",
      "claim_text": "Archer completed the build out of a production facility in San Jose, California, which will be used to produce the initial Midnight aircraft for the FAA certification program.",
      "subject": "Archer Aviation",
      "predicate": "operates_facility_in",
      "object_value": "San Jose, California - production facility (completed)",
      "source_quote": "we completed the build out of a production facility in San Jose, California, which we will utilize to produce the initial Midnight aircraft used as part of our FAA certification program",
      "category": "facility_existence"
    },
    {
      "claim_id": "achr_proprietary_propulsion_ip",
      "claim_text": "Archer asserts proprietary IP in its 12-tilt-6 eVTOL aircraft configuration, electric propulsion system (electric motors, batteries) and flight control software, distinguishing it from competitors.",
      "subject": "Archer Aviation",
      "predicate": "owns_patents_in",
      "object_value": "eVTOL configuration, electric propulsion (motors, batteries), flight control software",
      "source_quote": "a key aspect of our strategy has been to focus our internal component development efforts on only the key enabling technologies like our electric propulsion system and flight control software ... designed around our proprietary 12-tilt-6 aircraft configuration",
      "category": "ip_portfolio"
    },
    {
      "claim_id": "achr_external_brand_footprint",
      "claim_text": "Archer's Midnight eVTOL aircraft and Archer Aviation as a brand are discussed by external US-listed counterparties (suppliers, partners, competitors) in their SEC filings.",
      "subject": "Archer Aviation / Midnight",
      "predicate": "is_discussed_in_external_filings",
      "object_value": "Distinct brand 'Archer Aviation' / 'Midnight eVTOL'",
      "source_quote": "Our production aircraft, Midnight, which we unveiled in November of 2022, is designed around our proprietary 12-tilt-6 aircraft configuration.",
      "category": "external_validation"
    },
    {
      "claim_id": "achr_going_concern_liquidity",
      "claim_text": "As of December 31, 2023, Archer had cash and cash equivalents of $464.6 million, accumulated deficit of $1,148.8 million, and used $271.6 million in operations in 2023; management believes existing cash will fund operations for at least 12 months.",
      "subject": "Archer Aviation",
      "predicate": "has_liquidity_position",
      "object_value": "$464.6M cash; $271.6M annual ops burn; ~17 months runway absent further financing; FAA cert not expected before late 2025",
      "source_quote": "As of December 31, 2023, our principal sources of liquidity were cash and cash equivalents of $464.6 million ... Net cash used in operating activities during the year ended December 31, 2023 was $271.6 million ... we do not expect our first production aircraft to be certified by the FAA until late 2025 or later.",
      "category": "financial_distress"
    }
  ],
