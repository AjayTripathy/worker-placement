  "claims": [
    {
      "claim_id": "ssys-1",
      "claim_text": "General Motors is a strategic customer; GM's new multi-million-dollar additive manufacturing facility in Michigan features Stratasys systems from low to high end.",
      "subject": "Stratasys",
      "predicate": "supplies AM systems to",
      "object_value": "General Motors (Michigan AM facility)",
      "source_quote": "These include: General Motors, whose new multi-million-dollar additive manufacturing facility in Michigan features Stratasys systems from low to high end",
      "category": "named_counterparty_customer"
    },
    {
      "claim_id": "ssys-2",
      "claim_text": "Boeing is among the prominent diverse customers of Stratasys.",
      "subject": "Stratasys",
      "predicate": "supplies",
      "object_value": "Boeing",
      "source_quote": "We have a diverse set of customers worldwide, including, among other prominent companies: General Motors; BAE Systems; Boeing; Blue Origin, the U.S. Navy and the Mayo Clinic.",
      "category": "named_counterparty_customer"
    },
    {
      "claim_id": "ssys-3",
      "claim_text": "The U.S. Army signed an approximate $8 million contract with Stratasys in 2023 for a purchase that included systems from all five Stratasys platforms.",
      "subject": "Stratasys",
      "predicate": "received contract from",
      "object_value": "U.S. Army (~$8M, 2023)",
      "source_quote": "the U.S. Army, which signed an approximate $8 million contract with Stratasys in 2023 for a purchase that included systems from all five Stratasys platforms",
      "category": "named_counterparty_government_order"
    },
    {
      "claim_id": "ssys-4",
      "claim_text": "Stratasys operates FDM manufacturing and assembly operations from owned buildings in Eden Prairie, Minnesota (308,646 sq ft total).",
      "subject": "Stratasys",
      "predicate": "operates manufacturing facility in",
      "object_value": "Eden Prairie, Minnesota",
      "source_quote": "We own buildings in Eden Prairie, Minnesota, which we use to conduct our FDM manufacturing and assembly operations... approximately 308,646 square feet, of which we owned 227,100 square feet, in three buildings.",
      "category": "factory_location"
    },
    {
      "claim_id": "ssys-5",
      "claim_text": "Stratasys acquired three new sites in 2023 via the Covestro AM acquisition, including Elgin, Illinois (27,384 sq ft) for resin/materials manufacturing.",
      "subject": "Stratasys (Covestro AM business)",
      "predicate": "operates resin/materials manufacturing in",
      "object_value": "Elgin, Illinois",
      "source_quote": "In 2023 as part of our acquisition of Covestro Additive Manufacturing, we acquired three new sites-Elgin, Illinois, with 27,384 square feet... Our consumable materials development and production operations... are located at our facilities in Eden Prairie, Minnesota; Rehovot, Israel; Kiryat Gat, Israel; Elgin, Illinois...",
      "category": "factory_location"
    },
    {
      "claim_id": "ssys-6",
      "claim_text": "Stratasys holds approximately 2,600 granted and pending patents internationally, covering its 3D printing technologies including FDM, PolyJet, SAF, P3, and stereolithography.",
      "subject": "Stratasys",
      "predicate": "holds patent portfolio in",
      "object_value": "~2,600 patents/applications across FDM, PolyJet, SAF, P3, SLA",
      "source_quote": "We hold approximately 2,600 patents and pending patents internationally, and our 3D printing systems utilize our patented extrusion-based FDM, inkjet-based PolyJet, powder-bed-based SAF, photopolymer-based P3, and stereolithography technologies",
      "category": "patent_portfolio"
    },
    {
      "claim_id": "ssys-7",
      "claim_text": "Stratasys has over 500,000 parts already flying around the world today in aerospace applications, supported by deep applications-engineering expertise.",
      "subject": "Stratasys",
      "predicate": "has parts in service with",
      "object_value": "aerospace OEMs (>500,000 parts flying)",
      "source_quote": "where there are over 500,000 Stratasys parts already flying around the world today",
      "category": "external_brand_validation"
    }
  ],
