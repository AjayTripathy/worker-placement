  "claims": [
    {
      "claim_id": "C1",
      "claim_text": "Markforged operates an in-house manufacturing facility in greater Boston, Massachusetts where it produces consumables (composite/metal materials).",
      "subject": "Markforged",
      "predicate": "operates_manufacturing_facility",
      "object_value": "Massachusetts (greater Boston)",
      "source_quote": "Markforged is based in greater Boston, Massachusetts, where we have our own in-house manufacturing facility and our headquarters",
      "category": "facility_existence"
    },
    {
      "claim_id": "C2",
      "claim_text": "Markforged has a design and manufacturing facility in Hoganas, Sweden (acquired via Digital Metal AB) for metal binder jetting.",
      "subject": "Markforged / Digital Metal AB",
      "predicate": "operates_foreign_manufacturing_facility",
      "object_value": "Hoganas, Sweden",
      "source_quote": "We also have a design and manufacturing facility located in Hoganas, Sweden",
      "category": "facility_existence_foreign"
    },
    {
      "claim_id": "C3",
      "claim_text": "Markforged invented and patented the Continuous Fiber Reinforcement (CFR) additive manufacturing process and asserts a proprietary IP portfolio in composite/metal 3D printing.",
      "subject": "Markforged",
      "predicate": "holds_patents_in_area",
      "object_value": "continuous fiber composite + metal binder jetting 3D printing",
      "source_quote": "Our patented Continuous Fiber Reinforcement ( CFR ) process uses continuous strands of composite fibers ... We invented and patented the CFR composite additive manufacturing process.",
      "category": "ip_portfolio"
    },
    {
      "claim_id": "C4",
      "claim_text": "Markforged has 'blue chip customers' in aerospace, military and defense, automotive, healthcare, space exploration, and food and beverage industries.",
      "subject": "Markforged",
      "predicate": "has_named_industry_customers",
      "object_value": "aerospace / defense / automotive / healthcare / space",
      "source_quote": "Blue chip customers in industries such as food and beverage, aerospace, military and defense, industrial automation, space exploration, healthcare and automotive rely on our platform",
      "category": "external_customer_validation"
    },
    {
      "claim_id": "C5",
      "claim_text": "Markforged operates a global fleet of 'thousands of connected printers' generating data for an AI-powered closed-loop additive manufacturing software offering (Eiger / Digital Forge).",
      "subject": "Markforged",
      "predicate": "operates_distinctive_product_platform",
      "object_value": "Eiger / Digital Forge / FX20 / FX10 / Metal X printer fleet",
      "source_quote": "The data generated by our fleet of thousands of connected printers flows into our AI-powered, closed-loop additive manufacturing solution... We have integrated Teton's technology as a feature of our printing software solution, Eiger",
      "category": "product_market_footprint"
    },
    {
      "claim_id": "C6",
      "claim_text": "Markforged customers in the automotive industry rely on the platform (testable via Ford / GM 10-K mentions of Markforged or distinctive products).",
      "subject": "Markforged",
      "predicate": "has_named_counterparty_customer_automotive",
      "object_value": "Ford / GM as user of Markforged platform",
      "source_quote": "Blue chip customers in industries such as ... automotive rely on our platform",
      "category": "named_counterparty"
    },
    {
      "claim_id": "C7",
      "claim_text": "Markforged customers in the aerospace / defense industry rely on the platform (testable via Lockheed / Raytheon 10-K mentions of Markforged).",
      "subject": "Markforged",
      "predicate": "has_named_counterparty_customer_defense",
      "object_value": "Lockheed Martin / Raytheon as user of Markforged platform",
      "source_quote": "Blue chip customers in industries such as ... aerospace, military and defense ... rely on our platform",
      "category": "named_counterparty"
    },
    {
      "claim_id": "C8",
      "claim_text": "Industry context: 3D printing competitors Stratasys / Nano Dimension / Materialise reference Markforged in their public filings (competitive footprint test).",
      "subject": "Markforged",
      "predicate": "discussed_by_industry_peers",
      "object_value": "competitor 10-K mentions",
      "source_quote": "We compete for customers with a wide variety of producers of additive manufacturing equipment ... Some of our existing and potential competitors are researching, designing, developing and marketing other types of products and services",
      "category": "competitor_validation"
    }
