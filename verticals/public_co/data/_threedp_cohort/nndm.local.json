  "claims": [
    {
      "claim_id": "C1",
      "claim_text": "Nano Dimension owns approximately 14.02% of Stratasys Ltd. ordinary shares (9,695,115 shares, ~$138.4M market value at year-end 2023) and made a December 2023 all-cash proposal to acquire all remaining Stratasys shares at $16.50/share.",
      "subject": "Nano Dimension Ltd.",
      "predicate": "owns/intends-to-acquire",
      "object_value": "Stratasys Ltd. (SSYS) - 14.02% stake; pending all-cash buyout offer at $16.50/share",
      "source_quote": "We currently own approximately 14.02% of Stratasys outstanding shares and have been its largest shareholder since July 2022. ... In December 2023, we submitted a preliminary all cash proposal to purchase all the outstanding shares of Stratasys that we did not already own for $16.50 per share in cash.",
      "category": "named_counterparty"
    },
    {
      "claim_id": "C2",
      "claim_text": "Nano Dimension has a substantial and growing intellectual property portfolio of over 100 issued U.S. and foreign patents and approximately 200 pending applications across mechanical, software, materials, and design areas, filed via USPTO/WIPO and patent offices in China, Japan, Taiwan, Europe and South Korea.",
      "subject": "Nano Dimension Ltd.",
      "predicate": "owns",
      "object_value": ">100 issued patents + ~200 pending; tech areas include inkjet 3D printers, DLP/SLA, materials, AI",
      "source_quote": "We have an ever-growing portfolio of over 100 issued U.S. and foreign patents and approximately 200 provisional and non-provisional patent applications with the USPTO, WIPO ... 1. Mechanical: covering various printers components and peripherals, for example- granted U.S. patents (9,227,444, 9,259,933, 9,878,549 and 11,141,909) for ink jet 3D printers, indirect stereo lithography and DLP",
      "category": "ip_portfolio"
    },
    {
      "claim_id": "C3",
      "claim_text": "Nano Dimension acquired six businesses in the past three years: DeepCube and NanoFabrica (April 2021), Essemtec AG (Nov 2021), Global Inkjet Systems / GIS (Jan 2022), Formatec Holding incl. Admatec and Formatec (July 2022), and the asset acquisition of Additive Flow (August 2023).",
      "subject": "Nano Dimension Ltd.",
      "predicate": "acquired",
      "object_value": "DeepCube, NanoFabrica, Essemtec, GIS, Formatec Holding, Additive Flow",
      "source_quote": "we acquired all of the issued and outstanding share capital of DeepCube and NanoFabrica in April 2021, all of the issued and outstanding share capital of Essemtec in November 2021, all of the issued and outstanding share capital of GIS in January 2022, all of the issued and outstanding share capital of Formatec Holding in July 2022. ... Additive Flow, a U.K.-based company, in August 2023.",
      "category": "external_brand_validation"
    },
    {
      "claim_id": "C4",
      "claim_text": "Nano Dimension's portfolio of 3D printers - including DragonFly IV (additive electronics inkjet for PCBs), Fabrica 2.0 (Micro-AM DLP) and Admaflex (industrial AM DLP for ceramic and metal parts) - has met the needs of thousands of customers in aerospace/defense, automotive, electronics/PCB, industrial, medical, and R&D/academia.",
      "subject": "Nano Dimension Ltd.",
      "predicate": "sells products to",
      "object_value": "thousands of customers across aerospace/defense, automotive, electronics, industrial, medical sectors; products: DragonFly IV, Fabrica 2.0, Admaflex",
      "source_quote": "Our portfolio of 3D printers include: (i) AME inkjet printers known as DragonFly IV ... (ii) Micro Additive Manufacturing (Micro-AM) Digital Light Processing, or DLP, printers known as Fabrica 2.0 ... (iii) Industrial AM DLP printers known as Admaflex ... critical components that have met the needs of thousands of customers in the most technologically advanced, competitive, and innovative industries such as aerospace/defense, automotive, electronics and PCB, industrial, medical, and research and development/academia.",
      "category": "external_brand_validation"
    },
    {
      "claim_id": "C5",
      "claim_text": "Nano Dimension operates a US office in Waltham, Massachusetts (Nano USA Inc., Delaware) of approximately 25,400 square feet for sales/marketing/customer support, plus a smaller Essemtec USA, LLC operation.",
      "subject": "Nano Dimension USA Inc. / Essemtec USA, LLC",
      "predicate": "operates US office at",
      "object_value": "Waltham, MA - ~25,400 sq ft (sales/marketing/support)",
      "source_quote": "Our U.S. office is in Waltham, Massachusetts, where we currently lease and occupy approximately 25,400 square feet. The total monthly rent payment for the facilities in Waltham is currently approximately $65,000. ... Nano Dimension USA Inc., or Nano USA, a Delaware corporation, Essemtec USA, LLC, a Delaware limited liability company",
      "category": "factory_at_state"
    },
    {
      "claim_id": "C6",
      "claim_text": "As of December 31, 2023, Nano Dimension had $309.6M in cash and equivalents plus $542.0M in short-term unrestricted bank deposits, after a $96M share repurchase plan, with 2023 revenue of $56.3M (up from $43.6M in 2022).",
      "subject": "Nano Dimension Ltd.",
      "predicate": "reports financial position",
      "object_value": "$851.5M cash+ST deposits; $56.3M 2023 revenue; $54.6M net loss",
      "source_quote": "we had $309,571,000 in cash and cash equivalents and an additional $541,967,000 in short-term unrestricted bank deposits. ... Total revenue 10,493 43,633 56,314 ... Loss attributable to the owners of the Company (thousands USD) 200,777 227,423 54,550",
      "category": "financial_position"
    }
  ],
