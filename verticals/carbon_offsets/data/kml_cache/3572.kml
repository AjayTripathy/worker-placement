  <tr><td><b>District </b></td><td>$[Geo tag 3 Farmer/District_]</td></tr>
  <tr><td><b>Name of Block </b></td><td>$[Geo tag 3 Farmer/Name_of_Block_]</td></tr>
  <tr><td><b>Name of Village </b></td><td>$[Geo tag 3 Farmer/Name_of_Village_]</td></tr>
  <tr><td><b>Year of Plantation</b></td><td>$[Geo tag 3 Farmer/Year_of_Plantation]</td></tr>
  <tr><td><b>Species Name</b></td><td>$[Geo tag 3 Farmer/Species_Name]</td></tr>
  <tr><td><b> Area in Ha.</b></td><td>$[Geo tag 3 Farmer/_Area_in_Ha_]</td></tr>
  <tr><td><b>Latitude</b></td><td>$[Geo tag 3 Farmer/Latitude]</td></tr>
