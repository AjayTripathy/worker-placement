{"resourceIdentifier":"720","resourceName":"Tree Planting in South African townships","description":"The project will plant fruit trees3 and indigenous trees in townships across South Africa using funding specifically earmarked by sponsors for carbon offsetting.  Trees will be planted in private household gardens. Residents of houses are given tenure through South Africa?s Reconstruction and Development Programme (RDP)4, or the houses are bonded through banks with tenure secured conditional to meeting bond repayments5. Planting will not occur within informal settlements without secure land tenure. Planting will also not occur on State land such as parks and school grounds. Trees will be planted under the existing Trees for Homes (TfH) Programme. Trees planted as part of the project activity will be an expansion of current operations made possible by finance from carbon investments. This carbon funding stream will be kept separate from regular funding under the TfH programme.","location":{"latitude":-34.300920,"longitude":21.941727},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"720"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Gauteng"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Food and Trees for Africa (FTFA)"},{"type":"string","value":"Jilin Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"9"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"ARR"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AR-AM0002"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"84 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"SCS Global Services"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/09/2011 - 31/08/2051"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=33191&IDKEY=0kjalskjf098234kj28098sfkjlf098098kl32lasjdflkj909845770389","documentType":"Project Description","documentName":"PROJ_DESC_720_01SEP2011.pdf","uploadDate":"2017-05-10T06:17:20Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=33193&IDKEY=s097809fdslkjf09rndasfufd098asodfjlkduf09nm23mrn87s45773147","documentType":"Registration Representation","documentName":"PP_REG_REP_720_05SEP2011.pdf","uploadDate":"2017-05-10T06:17:20Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=43090&IDKEY=898klasmf8jflkasf8098afnasfkj98f0a9sfsakjflsakjf8d959421110","documentType":"Validation Report","documentName":"VALID_REP_720_02SEP2011.pdf","uploadDate":"2017-05-10T06:17:20Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=33192&IDKEY=flksjoiuwqowrnoiuomnckjashoufifmln902309ksdflku098n45771768","documentType":"Validation Representation","documentName":"VALID_STA_720_06SEP2011.pdf","uploadDate":"2017-05-10T06:17:20Z"}]},{"code":"VCS_ISSUANCE_DOCUMENTS","description":"VCS Issuance Documents","documents":[]},{"code":"VCS_OTHER_DOCUMENTS","description":"VCS Other Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=33194&IDKEY=j0e98hfalksuf098fnsdalfkjfoijmn4309JLKJFjlaksjfla9l45774526","documentType":"Communications Agreement","documentName":"COMMS_AGR_720_02SEP2011.pdf","uploadDate":"2017-05