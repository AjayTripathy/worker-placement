{"resourceIdentifier":"446","resourceName":"The SPM Group Biogas Project","description":"The proposed project activity is a grouped project consisting of four farms under the SPM group – SPM1, SPM2, SPM4 and SPM5. Farms SPM1 and SPM2 each have two separate biogas units named as SPM1.1, SPM1.2, SPM2.1 and SPM2.2. The project uses the Clean Development Mechanism (CDM) small-scale methodology AMS III.D for the methane component and AMS I.D for the electricity displacement component.","location":{"latitude":13.341516,"longitude":99.736883},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"446"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Ratchaburi Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"SPM Feedmill Co., Ltd."}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"446"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"59001"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-I.D.,AMS-III.D."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Swiss Association for Quality and Management Systems (SQS)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[]},{"code":"VCS_ISSUANCE_DOCUMENTS","description":"VCS Issuance Documents","documents":[]},{"code":"VCS_OTHER_DOCUMENTS","description":"VCS Other Documents","documents":[]}],"childResources":[]}