{"resourceIdentifier":"2319","resourceName":"Agroforestry plantation Bateke Plateau, Republic of Congo","description":"This savannah Land Afforestation Project on the Batéké Plateaus north of Brazzaville aims to develop an alternative and renewable source of wood for urban use, based on the establishment of forest plantations adapted to these needs. These plantations will be set up in anthropogenic savannahs, i.e. land with a biomass stock blocked at a very low stage due to recurrent bushfires. The savannahs are deliberately fired at frequent intervals (at least once a year) by villagers to facilitate agricultural, pastoral and cynegetic\r\nactivities.\r\nThe production of wood will be provided by the plantations of Acacia auriculoformis. The coal transformation\r\nwill be carried out using improved traditional carbonization techniques. The bags of coal produced will then\r\nbe transported to Brazzaville and will mainly supply the local industry.\r\nThe Acacia rows will be intercropped with lines of food crops, forming agroforestry plantations. Food crops will be managed by local communities and will ensure self-sustainability while supplying the local food chain.","location":{"latitude":-3.894407,"longitude":15.555597},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2020-07-13","endExclusive":"2020-08-13","endInclusive":"2020-08-12"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2319"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Republic of Congo"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"FRM Commitment"},{"type":"string","value":"Mauguio, France"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2319"},{"type":"bufferSearchLink","value":null,"targetId":"2319"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"36102"}]},{"code":"TOTAL_BUFFER_POOL_CREDITS","values":[{"type":"integer","value":12770}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"ARR"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AR-ACM0003"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"7454 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"AENOR CONFIA, S.A. (UNIPERSONAL)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"07/03/2023"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/08/2018 - 31/07/2051"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=47227&IDKEY=78723kjnf7kjandsaslmdv09887vaksmrmnwqkjoiuanfnfuq0i65126033","documentType":"Draft Project Description","documentName":"VCSv4_PDD_IbinaENG20200619&cartes&annexesRv2.pdf","uploadDate":"2020-06-29T13:05:29.473Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=47228&IDKEY=fiquwesdfmnk0iei23nnm435oiojnc909dsflk9809adlkmlkf965127412","documentType":"Listing Representation","documentName":"VCS-Listing-Representation.pdf","uploadDate":"2020-06-29T13:09:21.2Z"}]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=85987&IDKEY=fkjalskjf098234kj28098sfkjlf098098kl32lasjdflkj909j118576073","documentType":"Project Description","documentName":"20211006VCS_PDD_SPF2B_v28&annexs.pdf","uploadDate":"2023-03-07T11:34:15.947Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=66847&IDKEY=kq934lkmsad39asjdkfj90qlkalsdkngaf98ulkandDfdvDdfh392182013","documentType":"Registration Represen