{"resourceIdentifier":"897","resourceName":"Exploitation of the biogas from Controlled Landfill in Solid Waste Management Central – CTRS / BR.040","description":"The Project will consist of a collection, transport and treatment system for landfill gas with production of electricity for self-consumption and incorporation to the national grid. Since the landfill gas major constituent is methane, whose GHG potential is 21 times the CO2, the Project will reduce the emission of  GHG into the atmosphere by means of methane destruction in high temperature flares and of displacement of electricity generated from fossil fuel sources.","location":{"latitude":-20.084166,"longitude":-45.981943},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"897"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Minas Gerais"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"897"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"134160"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"RINA Services S.p.A"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"CREDITING PERIOD HAS EXPIRED, 29/10/2009 - 28/10/2019"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/Pr