{"resourceIdentifier":"4883","resourceName":"Agroforestry Project of Cameroon","description":"The objective of the Agroforestry Project of Cameroon is to reforest an area of around 10,000 hectares, starting with degraded plots in Cameroon currently managed as unused or under-used agricultural lands or degraded grasslands, and reforest the landscape while sequestering carbon dioxide. The degraded land will be rehabilitated with tree canopy cover, and over time local hydrology and soil health will be restored. The grouped Project will control erosion and increase water infiltration, as well as provide local employment opportunities while contributing to the region’s food security.","location":{"latitude":4.318811,"longitude":9.474709},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2024-01-05","endExclusive":"2024-02-05","endInclusive":"2024-02-04"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4883"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"12"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"ARR"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AR-ACM0003"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"1 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"AENOR CONFIA, S.A. (UNIPERSONAL)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"20/05/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 18/04/2024 - 17/04/2064"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","d