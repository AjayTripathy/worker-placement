{"resourceIdentifier":"3869","resourceName":"Yangxiang AWMS GHG Mitigation Project in Hebei province","description":"Yangxiang AWMS GHG Mitigation Project in Hebei province (hereinafter as “the proposed project”) locates in Xingtai City, Xingtai City and Hengshui City, Hebei province, China. The proposed project introduces new animal waste management systems to treat the manure from 5 swine farms in Hebei province Each subsidiary swine farm will install one animal waste management system, and the manure is treated on site. The purpose of the project activity is to treat the manure and wastewater to avoid methane emissions generated in the baseline uncovered anaerobic lagoons.","location":{"latitude":38.134389,"longitude":115.588611},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-01-27","endExclusive":"2023-02-27","endInclusive":"2023-02-26"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3869"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Hebei Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Henan Yangxiang Breeding Co., Ltd"},{"type":"string","value":"Henan Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"38242"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.D.,AMS-III.F."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Carbon Check (India) Private Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"20/03/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 10/06/2021 - 09/06/2031"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[