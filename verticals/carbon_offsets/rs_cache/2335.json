{"resourceIdentifier":"2335","resourceName":"Zhangjiakou Landfill Gas Power Generation Project","description":"The project is located in Majiawan Landfill site, Yaojiazhuang town Qiaodong District, Zhangjiakou city. The project is a landfill gas collection and utilization project. The project will collect landfill gas (methane) and use it for electricity generation and the installed capacity is 3 MW. The power generated by plant is delivered to North China Power Grid. The annual power generation is expected to be 22,000 MWh. The annual emission reduction is expected to be 100,000 tons.","location":{"latitude":40.761665,"longitude":114.956130},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2020-09-04","endExclusive":"2020-10-05","endInclusive":"2020-10-04"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2335"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Hebei Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Zhangjiakou Xinzhongshui Energy Technology Ltd."},{"type":"string","value":"Hebei Province, China"},{"type":"string","value":"+86 13833315220"},{"type":"string","value":"870782302@qq.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2335"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"137156"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"11/11/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 03/01/2019 - 02/01/2029"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","d