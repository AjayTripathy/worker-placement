{"resourceIdentifier":"3078","resourceName":"Puyang County Rural MSW Landfill Site LFG Pollution Treatment and Comprehensive Utilization Project","description":"Puyang County Rural MSW Landfill Site LFG Pollution Treatment and Comprehensive Utilization Project (hereafter referred to as the project) is located in Xihanxin Village, Bagongqiao Town, Puyang County, Puyang City, Henan Province, P.R. China. The project is constructed and operated by Puyang County Baichang Environmental Protection New Energy Co., Ltd. The objective is to collect the landfill gas (LFG) from Puyang County Rural MSW landfill site (hereafter referred to as Puyang Rural landfill site) and utilize it to generate electricity.","location":{"latitude":35.589387,"longitude":115.107579},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-05-17","endExclusive":"2022-06-17","endInclusive":"2022-06-16"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3078"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Henan Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Henan BCCY Environmental Energy CO.,LTD."},{"type":"string","value":"Henan, China"},{"type":"string","value":"86 371 6552 1782"},{"type":"string","value":"lwang@bccynewpower.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3078"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"32916"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Energy industries (renewable/non-renewable sources)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-I.D.,AMS-III.G."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"12/