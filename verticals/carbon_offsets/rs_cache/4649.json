{"resourceIdentifier":"4649","resourceName":"CBG Plant at Sainsons","description":"The purpose of project activity is extraction and capture of methane enriched bio-gas generated from treatment of waste water. The captured biogas is treated further to remove impurities and bottled as compressed biogas to supply to oil company for replacing fossil origin natural gas used in vehicles for transportation. In case any shutdown of CBG plant excess methane gas will be flared in controlled manner in an open flare.","location":{"latitude":30.016387,"longitude":76.527777},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-11-23","endExclusive":"2023-12-24","endInclusive":"2023-12-23"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4649"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Haryana"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"30091"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.H.,AMS-III.AQ"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"KBS Certification Services Limited"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"04/12/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/04/2022 - 31/03/2029"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=101431&IDKEY=9lksjoiuwqowrnoiuomnckjashoufifmln902309ksdflku098l139873349","documentType":"Draft Project Description","documentName":"VCS_PROJ_DESC_DRAFT_4649_10