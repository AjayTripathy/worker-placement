{"resourceIdentifier":"3021","resourceName":"Reducing Gas Leakages within North West and other sub-areas of the Titas Gas Distribution Network in Bangladesh","description":"The proposed project aims to reduce gas leaks from components through the implementation of an advanced Leak Detection and Repair Program in gas infrastructure systems operated by Titas Gas Transmission Distribution Company Limited (Titas) in the People’s Republic of Bangladesh.  Specifically, the project will identify, measure, and make repairs using advanced leak detection and measurement equipment and repair materials in selected Divisions of Dhaka, Narayanganj, Sonargaon, Gazipur, and Savar where no such effort currently exists.","location":{"latitude":23.790176,"longitude":90.401100},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-05-10","endExclusive":"2022-06-10","endInclusive":"2022-06-09"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3021"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Dhaka, Narayanganj, Sonargaon, Gazipur, Savar"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Carbon Projects LLC"},{"type":"string","value":"DE, United States"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3021"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"1090993"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Fugitive emissions from fuels (solid, oil and gas)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AM0023"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Carbon Check (India) Private Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"26/10/2022"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/06/2022 - 31/05/2032"}]}