{"resourceIdentifier":"707","resourceName":"Kunming Dongjiao Baishuitang LFG Treatment and Power Generation Project","description":"The project consists of a collection, transport and treatment system for landfill gas with production of electricity for self-consumption and incorporation to the national grid. Since the landfill gas major constituent is methane, whose GHG potential is 21 times the CO2, the project will reduce the emissions of GHG into the atmosphere by means of i) methane destruction in high temperature flares and/or power generation engines and ii) of displacement of electricity generated from fossil fuel sources.","location":{"latitude":24.989722,"longitude":102.863883},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"707"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Yunnan"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Kunming Huan Ye Project Development Co. Ltd."}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"707"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"62403"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001,ACM0002"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"RINA Services S.p.A"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"03/11/2011"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"CREDITING PERIOD HAS EXPIRED, 21/11/2008 - 20/11/2018"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://