{"resourceIdentifier":"559","resourceName":"Cambria 33 Abandoned Mine Methane Capture and use Project","description":"The project activity is to install facility to collect and use methane from abandoned coal mines (AMM), which will otherwise be emitted into the atmosphere. The AMM is withdrawn with vacuum pumps from bore holes (Pileski #2 and #3) and then cleaned, compressed, odorized and injected to a nearby pipe line owned by the local natural gas company. For injection to pipeline, the methane is delivered to a pressure swing adsorption unit for purification; the resulting methane gas is then compressed into a pipeline connect","location":{"latitude":40.431280,"longitude":-78.755071},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"559"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"PA"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Vessels Coal Gas Inc."},{"type":"string","value":"CO, United States"},{"type":"string","value":"303-534-0488"},{"type":"string","value":"tvessels@vesselscoalgas.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"559"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"69446"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Fugitive emissions from fuels (solid, oil and gas)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"VMR0002"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Det Norske Veritas Climate Change Services AS (DNV)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"14/01/2011"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"CREDITING PERIOD HAS EXPIRED, 01/05/2008 - 30/04/2018"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS",