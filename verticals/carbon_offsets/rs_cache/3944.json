{"resourceIdentifier":"3944","resourceName":"Jinmu AWMS GHG Mitigation Project in Liaoning Province","description":"The project activity uses dry scraper system to collect the manure automatically and the remaining manure, urine and wastewater are collected and then be separated first. The separated liquid will be treated through anaerobic digestion, The biogas produced during the treatment process will be directly incinerated. The effluent will be used as a liquid organic fertilizer for the irrigation of agriculture.The residual waste from the dry manure storage room will be sent outside of the project site for aerobic composting and then returned to the field as fertilizer.","location":{"latitude":42.196854,"longitude":122.692147},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-03-10","endExclusive":"2023-04-10","endInclusive":"2023-04-09"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3944"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Liaoning Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Henan Yangxiang Breeding Co., Ltd"},{"type":"string","value":"Henan Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3944"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"38716"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.D.,AMS-III.F."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"15/12/2023"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 24/06/2021 - 23/06/2031"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENT