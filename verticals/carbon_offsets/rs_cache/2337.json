{"resourceIdentifier":"2337","resourceName":"Sanya Landfill Gas Power Generation Project","description":"The project is located in Yijiaoling Landfill site, Nandao Farm Unit 14 Sanya City, Hainan Province. The project is a landfill gas collection and utilization project. The project will collect landfill gas (methane) and use it for electricity generation and the installed capacity is 2.134 MW. The power generated by plant is delivered to South China Power Grid. The annual power generation is expected to be 16,000 MWh. The annual emission reduction is expected to be 70,000 tons.","location":{"latitude":18.365399,"longitude":109.419443},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2020-08-31","endExclusive":"2020-10-01","endInclusive":"2020-09-30"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2337"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Hainan Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Hainan Sanya Xinzhongshui Enviromental Protection Technology Co., Ltd."},{"type":"string","value":"Hainan Province, China"},{"type":"string","value":"+86 18889732374"},{"type":"string","value":"1365123983@qq.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2337"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"89751"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"02/12/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 22/03/2019 - 21/03/2029"}]}]}],"docume