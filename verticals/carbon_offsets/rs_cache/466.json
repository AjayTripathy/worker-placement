{"resourceIdentifier":"466","resourceName":"McCommas Bluff Landfill Gas Processing Facility – Gas Production and Distribution Project","description":"The project activity occurs in expansion cells at the McCommas Bluff landfill. Although the landfill is required under NSPS requirements to collect and destroy landfill gas, expansion cells are not required to install a gas collection system until five years from the date on which they initially accept waste. The project activity consists of the voluntary installation of a gas collection system prior to the effective date of NSPS requirements in expansion areas of the landfill. Gas collected is purified in Dallas Clean Energy’s processing plant at the landfill and injected into a pipeline distribution network or flared.","location":{"latitude":32.679722,"longitude":-96.728333},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"466"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"TX"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Dallas Clean Energy LLC"},{"type":"string","value":"Lima, Peru"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"466"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"329299"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"First Environment, Inc. (First Environment)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Regis