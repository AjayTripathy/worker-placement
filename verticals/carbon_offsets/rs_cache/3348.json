{"resourceIdentifier":"3348","resourceName":"Huizhou Landfill Gas Power Generation Phase III and IV Project","description":"Huizhou Landfill Gas Power Generation Phase III and IV Project (hereafter referred to as the project) is invested and owned by Shenzhen PhasCon Technologies Co., Ltd. (hereafter referred to as the project owner). The project captures the landfill gas that would have been released to the atmosphere in the absence of the project and generates electricity with the landfill gas (LFG). The electricity is supplied to the China Southern Power Grid (CSPG) to replace the electricity generated from coal-fired power plants of CSPG.","location":{"latitude":23.109130,"longitude":114.347948},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-10-25","endExclusive":"2022-11-25","endInclusive":"2022-11-24"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3348"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Guangdong Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Shenzhen PhasCon Technologies Co., Ltd."},{"type":"string","value":"Guangdong Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3348"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"273134"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"13/06/2023"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 14/12/2020 - 13/12/2027"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","desc