{"resourceIdentifier":"3005","resourceName":"Tongxu Biogas Recovery and Utilization Project","description":"The project is to collect methane from swine manure treatment at Tongxu Lizhai Swine Farm in Tongxu County, Kaifeng City, Henan Province. The project treats the raw manure from 125,650 market swine annually by anaerobic digester, and uses the biogas generated during the treatment process for heat generation. The project owner uses the gravity and scraping system to collect the manure automatically, and all the manure is flushed and pumped to the\r\nanaerobic digester. After anaerobic digestion, the digestate is used for agriculture irrigation aerobically. Therefore, the reduction, resource utilization, harmlessness, and ecological utilization of the manure from the swine farm can be realized.","location":{"latitude":34.537219,"longitude":114.540829},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-05-17","endExclusive":"2022-06-17","endInclusive":"2022-06-16"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3005"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Henan Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Tongxu Agro-pastoral Co., Ltd."},{"type":"string","value":"Henan Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3005"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"136134"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0010"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"0 Acres"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"s