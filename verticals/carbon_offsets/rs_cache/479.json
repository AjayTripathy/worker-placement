{"resourceIdentifier":"479","resourceName":"Curva de Rodas and La Pradera landfill gas management project","description":"Curva de Rodas and La Pradera landfill gas flaring is a large-scale CDM project with multiple sites. The project is located in Medellin, Colombia. The total estimated emission reductions from the project is 1,171,245 t CO2e over the seven years crediting period. The project started operating during the summer 2008 and received registration by the UNFCCC on 6 February 2009. Green Gas, besides owning and managing the carbon credits, provided the technical solutions and has full control over the operation and maintenance of the project.","location":{"latitude":6.322730,"longitude":-75.530767},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"479"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Antioquia"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Green Gas Colombia"},{"type":"string","value":"Haryana., India"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"479"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"167321"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Tuev Sued Industrie Service GmbH (Tuev Sued)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"3rd, 07/07/2022 - 06/07/2029"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Doc