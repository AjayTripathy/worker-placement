{"resourceIdentifier":"409","resourceName":"MedcoEnergi Associated Gas Recovery and Utilization Project","description":"The purpose of the project activity is to capture and process associated gas that would otherwise have been flared. The captured gas is processed in an LPG plant. The installation of the LPG plant allows the recovery and processing of the associated gas into LPG, condensate, and residue gas. One of the main factors in choosing LPG as an option for associated gas utilization was due to relatively high composition (± 16% mole fraction) of propane and butane.","location":{"latitude":-2.825000,"longitude":104.075000},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"409"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"South Sumatera Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"PT. Medco LPG Kaji (MLK)"},{"type":"string","value":"TAMIL NADU, India"},{"type":"string","value":"044-28521526"},{"type":"string","value":"sivagurunathan@indiacements.co.in"},{"type":"string","value":"indiacements.co.in"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"409"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"86022"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Fugitive emissions from fuels (solid, oil and gas)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AM0009"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"TÜV NORD CERT GmbH"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"CREDITING PERIOD HAS EXPIRED, 28/03/2006 - 27/03/2016"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"