{"resourceIdentifier":"5214","resourceName":"Pingjiang County Domestic Waste Harmless Landfill Site LFG Utilization Project","description":"Pingjiang County Domestic Waste Harmless Landfill Site LFG Utilization Project (hereafter referred to as the project) is located at Taxing Village, Wengjiang Town, Pingjiang County, Yueyang City, Hunan Province, P. R. China. The project is invested, constructed and operated by Pingjiang Baichang New Energy Co., Ltd. The objective is to collect the landfill gas (LFG) from Pingjiang County Domestic Waste Harmless landfill site (hereafter referred to as Pingjiang landfill site) and utilize it to generate electricity.","location":{"latitude":28.734162,"longitude":113.509050},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2024-08-22","endExclusive":"2024-09-22","endInclusive":"2024-09-21"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"5214"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Hunan Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Henan BCCY Environmental Energy CO.,LTD."},{"type":"string","value":"Henan, China"},{"type":"string","value":"86 371 6552 1782"},{"type":"string","value":"lwang@bccynewpower.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"60882"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Energy industries (renewable/non-renewable sources)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"16/03/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 21/03/2023 - 20/03/2033"}]}]}],"d