{"resourceIdentifier":"2859","resourceName":"Jingbian County MSW landfill site LFG pollution treatment and  comprehensive utilization project","description":"Jingbian County MSW landfill site LFG pollution treatment and comprehensive utilization project (hereafter referred to as the project) is located in Yinwan Village, Tianciwan Town, Jingbian County, Yulin City, Shaanxi Province, P.R. China. The project is constructed and operated by Jingbian County Baichang New Energy Co., Ltd. The objective is to collect the landfill gas (LFG) from Jingbian County MSW landfill site (hereafter referred to as Jingbian landfill site) and utilize it to generate electricity.","location":{"latitude":37.519325,"longitude":108.849266},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-07-01","endExclusive":"2022-08-01","endInclusive":"2022-07-31"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2859"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Shaanxi Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Henan BCCY Environmental Energy CO.,LTD."},{"type":"string","value":"Henan, China"},{"type":"string","value":"86 371 6552 1782"},{"type":"string","value":"lwang@bccynewpower.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"34922"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Energy industries (renewable/non-renewable sources)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-I.D.,AMS-III.G."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"10/03/2023"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 17/12/2021 -