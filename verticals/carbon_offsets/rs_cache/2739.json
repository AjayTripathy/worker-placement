{"resourceIdentifier":"2739","resourceName":"Reducing Gas Leakages within the Pashchimanchal Gas Distribution Network in Bangladesh","description":"The project activity will reduce natural gas leakage in the distribution network of the Pashchimanchal Gas Distribution Company (PGCL) through the implementation of advanced leak detection and repairs (LDAR) procedures. The project activities will include inspection and leak measurements, as well as repair works at components in the natural gas above ground distribution system. using advanced leak detection and measurement technology including HiFlow Samplers. Leak Measurement Devices and Gasurveyors as well as advanced repair materials. In addition, selected staff of PGCL will be trained in advanced leak detection, measurement, and repair techniques.","location":{"latitude":24.421722,"longitude":89.598378},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-04-20","endExclusive":"2022-05-21","endInclusive":"2022-05-20"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2739"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Rajshahi,Sirajganj,Pabna,Bogura"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2739"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"371861"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Fugitive emissions from fuels (solid, oil and gas)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AM0023"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"KBS Certification Services Limited"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"27/09/2022"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","valu