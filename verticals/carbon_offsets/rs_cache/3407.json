{"resourceIdentifier":"3407","resourceName":"Heyuan Dengta Landfill Gas Power Generation Project","description":"The purpose of the project is to use LFG, which consists mainly of methane, for electricity generation. It includes LFG collection system, LFG pre-treatment system and electricity generation system. The total installed capacity of the project will be 4.0MW. LFG collected is used for electricity generation with internal combustion generators to generate about 145,343MWh supplying to CSPG during the first 7 years crediting period. The expected average annual emission reductions are 134,256 tCO2e and the total emission reductions are 939,790 tCO2e during the 7-year crediting period","location":{"latitude":23.990832,"longitude":114.760277},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-10-12","endExclusive":"2022-11-12","endInclusive":"2022-11-11"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3407"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Guangdong Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Shenzhen PhasCon Technologies Co., Ltd."},{"type":"string","value":"Guangdong Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"139586"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"17/05/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/01/2023 - 31/12/2029"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"