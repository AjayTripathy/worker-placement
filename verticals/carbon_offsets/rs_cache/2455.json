{"resourceIdentifier":"2455","resourceName":"Haicheng Landfill Gas Power Generation Project","description":"The project is located at Haicheng Landfill Site in Laojianshan, Yushu Village, Xiangtang Management District, Haicheng City, Liaoning Province, P.R China. The project is a landfill gas collection and utilization project. The project will collect landfill gas (methane) and use it for electricity generation and the installed capacity is 2 MW. The power generated by the plant is delivered to Northeast China Power Grid. The annual power generation is expected to be 16,000 MWh. The annual emission reduction is expected to be 80,000 tons.","location":{"latitude":40.834443,"longitude":122.799722},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2021-03-04","endExclusive":"2021-04-04","endInclusive":"2021-04-03"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2455"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Liaoning"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Haicheng Xinzhongshui Environmental Protection Technology Co., Ltd"},{"type":"string","value":"Liaoning Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2455"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"81914"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"05/08/2021"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 09/09/2019 - 08/09/2029"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pi