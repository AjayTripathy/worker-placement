{"resourceIdentifier":"367","resourceName":"Kitroongruang Biogas Energy Project","description":"The Kitroongruang Biogas Energy Project (hereafter, the Project) developed by Thai Biogas Energy Company Ltd (hereafter referred to as TBEC, or the Project Developer) is an anaerobic digestion project, which treats wastewater from the cassava processing factory owned by Kitroongruang Tapioca Factory Limited Partnerships (hereafter referred to as the Facility) in Rayong, Thailand. In the baseline scenario, the wastewater flows from the factory through a series of 9 low-maintenance anaerobic and aerobic lagoons. As the wastewater flows through the lagoons, organic material is broken down and resulting methane is released to the atmosphere.","location":{"latitude":12.769933,"longitude":101.148194},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"367"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Rayong Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Thai Biogas Energy Company Ltd"},{"type":"string","value":"HI, United States"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"367"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"17328"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0014"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"SGS United Kingdom Ltd. (SGS)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","docu