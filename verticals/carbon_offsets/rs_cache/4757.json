{"resourceIdentifier":"4757","resourceName":"JIANGSU SUQIAN AWMS Biogas Recovery and Utilization Project","description":"Jiangsu Suqian AWMS Biogas Recovery and Utilization Project (hereinafter referred to as the grouped project) is a grouped project which installs 4 new animal waste management systems (AWMSs) to treat the manure for 4 newly built swine farms in Suqian, Jiangsu Province. The grouped project is a greenfield project, it is owned and implemented by Muyuan Foods Co., Ltd. (hereinafter referred to as the project proponent). Each swine farm installs one set of AWMS to treat the manure on site. The purpose of the project activity is to treat the manure and wastewater to avoid methane emissions generated in the baseline uncovered anaerobic lagoons.","location":{"latitude":34.221837,"longitude":119.066147},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-12-20","endExclusive":"2024-01-20","endInclusive":"2024-01-19"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4757"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Jiangsu"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Muyuan Foods Co., Ltd."},{"type":"string","value":"Henan Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"95846"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Livestock, enteric fermentation, and manure management"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.D."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"13/01/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 07/08/2022 - 06/08/2032"}]}]}],"documentGroups":[{"code":"V