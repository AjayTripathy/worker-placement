{"resourceIdentifier":"3827","resourceName":"Kalyoncu Landfill Gas to Electricity Project.","description":"In order to develop a municipal solid waste management system that will be environmentally friendly and sustainable, Kalyoncu Landfill Gas to Electricity Project is being implemented by Körfez Enerji Sanayi ve Ticaret Anonim Şirketi. The project activity is a Landfill Gas Power Generating Plant with an installed capacity of 22.610 MWe. The project is built within the premises of Kalyoncu Landfill Facility in the Eyupsultan province of Istanbul city. According to the EMRA Generation License, the project lifetime is 10 years. The Solid Waste Landfill Site is located on a total area of 559,359 m2, of which 547,600 m2 is a landfill area and 11,759 m2 of electricity generation power plant area.","location":{"latitude":41.008200,"longitude":28.978400},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-12-19","endExclusive":"2023-01-19","endInclusive":"2023-01-18"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3827"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Istanbul"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Körfez Enerji Sanayi ve Ticaret Anonim Şirketi"},{"type":"string","value":"İstanbul, Turkey"},{"type":"string","value":"info@yesilholding.com"},{"type":"string","value":"www.yesilholding.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Verification approval requested"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"760566"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Energy industries (renewable/non-renewable sources)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT