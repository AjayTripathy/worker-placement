{"resourceIdentifier":"1071","resourceName":"Jatropha Agroforestry Senegal","description":"The Jatropha Agroforestry Senegal project developes Jatropha curcas plantations in the Fatick, Kaffrine and Kaolack regions, in central-western agricultural region of the Senegal. The Jatropha curcas plantations will cover a total area of 1411 hectares by the year 2020. The project proponent, African National Oil Corporation s.a.r.l. (ANOC), is developing the project in collaboration with CarbonSinkGroup s.r.l (www.carbonsink.it) and Agroils Technologies SpA (www.agroils.com).","location":{"latitude":13.991189,"longitude":-16.466134},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"1071"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"regions of Fatick, Kaolack and Kaffrine"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"African National Oil Corporation s.a.r.l."},{"type":"string","value":"Manaus, Brazil"},{"type":"string","value":"+ 55 92 9192 5172"},{"type":"string","value":"romeu@co2eq.com.br"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"1071"},{"type":"bufferSearchLink","value":null,"targetId":"1071"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"1742"}]},{"code":"TOTAL_BUFFER_POOL_CREDITS","values":[{"type":"integer","value":141}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"ARR"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AR-ACM0003"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"1411 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Det Norske Veritas Climate Change Services A