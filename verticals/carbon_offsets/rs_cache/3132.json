{"resourceIdentifier":"3132","resourceName":"Shangcai Chenfazhai Biogas Recovery and Utilization Project","description":"The project is to collect methane from swine manure treatment at Shangcai Chenfazhai Swine Farm in Shangcai County, Zhumadian City, Henan Province. The project treats the raw manure from 84,700 market swine and 9,700 breeding swine annually by anaerobic digester, and uses the biogas generated during the treatment process for heat generation. The project owner uses the gravity and scraping system to collect the manure automatically, and all the manure is flushed to the anaerobic digester. After anaerobic digestion, the digestate is used for agriculture irrigation aerobically. Therefore, the reduction, resource utilization, harmlessness, and ecological utilization of the manure from the swine farm can be realized.","location":{"latitude":33.195546,"longitude":114.421942},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-06-28","endExclusive":"2022-07-29","endInclusive":"2022-07-28"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3132"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Henan Province, P.R China"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Shangcai Agro-pastoral Co., Ltd."},{"type":"string","value":"Henan Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3132"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"113496"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0010"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"0 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code"