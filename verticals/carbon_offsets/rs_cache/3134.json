{"resourceIdentifier":"3134","resourceName":"Huaxian Caiying Biogas Recovery and Utilization Project","description":"The project is to collect methane from swine manure treatment at Huaxian Caiying Swine Farm in Huaxian County, Anyang City, Henan Province. The project treats the raw manure from 150,000 market swine and 15,000 breeding swine annually by anaerobic digester, and uses the biogas generated during the treatment process for heat generation. The project owner uses the gravity and scraping system to collect the manure automatically, and all the manure is\r\nflushed to the anaerobic digester. After anaerobic digestion, the digestate is used for agriculture irrigation aerobically. Therefore, the reduction, resource utilization, harmlessness, and ecological utilization of the manure from the swine farm can be realized.","location":{"latitude":35.584443,"longitude":114.853611},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-05-19","endExclusive":"2022-06-19","endInclusive":"2022-06-18"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3134"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Henan Province, P.R. China"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Huaxian Agro-pastoral Co., Ltd."},{"type":"string","value":"Henan Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Verification approval requested"},{"type":"assetSearchLink","value":null,"targetId":"3134"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"191968"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0010"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"0 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Lt