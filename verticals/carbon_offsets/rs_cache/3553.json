{"resourceIdentifier":"3553","resourceName":"COMMUNITY PARTICIPATIVE FORESTRY/AGROFORESTRY DEVELOPMENT PROJECT IN INDIA","description":"Grouped Reforestation Project on Degraded Land and Fallow Agricultural Land is located within the borders of India. The project aims to establish forests across India on degraded land and unused land not currently used for forestation. The first project activity instance (VPA) under the program is located in the state of Uttar Pradesh (Pratapgarh, Amethi, Sultanpur, Raebareli, Unnao, Prayagraj), Madhya Pradesh (Sagar, Tikamgarh) and Rajasthan (Rajsamand, Chittorgarh) in India Indian Farm Forestry Development Co-operative Limited (has implemented the VPA from 0 1 Jul 2015 covering an area of about 600 hectares. This project provides an opportunity for the rural poor to restore degraded lands and improve their living conditions. The project has assisted farmers, especially women, to promote plantation on wastelands and marginally productive lands by organizing primary farm forestry co-operatives and thus making it a people's participative programme. The project activities will help in improving soil and water conservation and bringing about ecological balance, and generating consistent employment for the rural poor and thus help them in their socio-economic development.","location":{"latitude":25.914963,"longitude":81.980052},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-04-06","endExclusive":"2023-05-07","endInclusive":"2023-05-06"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3553"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Uttar Pradesh"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Indian Farm Forestry Development Co-operative Ltd."},{"type":"string","value":"Gurgaon Haryana, India"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"10371"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"ARR"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AR-AMS0007"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"800 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Carbon Check (India) Private Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"21/03/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/07/2015 - 30/06/2035"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=87819&IDKEY=9iquwesdfmnk0iei23nnm435oiojnc909dsflk9809adlkmlkfk121102401","documentType":"Draft Project Description","documentName":"PD_VCS3553_evi20230315.pdf","uploadDate":"2023-04-05T10:41:17.26Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=87820&IDKEY=3903q4jsafkasjfu90amnmasdfkaidflnmdf9348r09dmfasdfs121103780","documentType":"Listing Representation","documentName":"Listing Representation- IFFDC.pdf","uploadDate":"2023-04-05T10:42:17.287Z"}]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=129328&IDKEY=9iquwesdfmnk0iei23nnm435oiojnc909dsflk9809adlkmlkf3178343312","documentType":"Project Description","documentName":"PD (VCS3553)-evi20250217 (Clean).pdf","uploadDate":"2025-03-21T11:05:47.983Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=92028&IDKEY=fq934lkmsad39asjdkfj90qlkalsdkngaf98ulkandDfdvDdfhk126906612","documentType":"Registration Representation","documentName":"VCS3553 R