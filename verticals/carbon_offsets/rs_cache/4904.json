{"resourceIdentifier":"4904","resourceName":"SF6 Alternate Cover Gas Conversion Project for AMACOR Magnesium Recycling Facility","description":"Production and casting of magnesium alloys requires protection against oxidation of the molten metal. While there are various protection systems used in the magnesium industry, the most common is use of Sulphur Hexafluoride (SF6) as a cover gas. SF6 is non-reactive and as such is very effective for protecting molten magnesium during the production process. However, it has a very high Global Warming Potential (GWP) of 23,500. AMACOR has installed an alternate cover gas system at its Facility to switch from SF6 to a perfluoro-2-methyl-3-pentanone product named Bestsolv Zulu. Thus, the baseline scenario as further detailed in the Project Document, is the continued use of SF6 as cover gas, while the project scenario is the use of the Bestsolv Zulu fluid as cover gas at the Facility. Since Perfluoro-2-methyl-3-pentanone has a lower GWP (2,380) compared with SF6, the substitution results in emission reductions.","location":{"latitude":40.327013,"longitude":-86.174693},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2024-02-26","endExclusive":"2024-03-28","endInclusive":"2024-03-27"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4904"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"IN"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Advanced Magnesium Alloys Corporation (AMACOR)"},{"type":"string","value":"Indiana, United States"},{"type":"string","value":"765-643-5873 x 296"},{"type":"string","value":"ashaked@amacor.us"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Verification approval requested"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"113726"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Fugitive emissions from production and consumption of halocarbons and sulphur hexafluoride"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AM0065"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"2 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Dillon Consulting Limited"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"09/05/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 02/04/2024 - 01/04/2034"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=107215&IDKEY=niofj09234rm9oq4jndsma80vcalksdjf98cxkjaf90823nmq3f147849485","documentType":"Draft Project Description","documentName":"VCS_PROJ_DESC_DRAFT_4904_22DEC2023.pdf","uploadDate":"2024-02-07T09:47:56.457Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=106754&IDKEY=kq934lkmsad39asjdkfj90qlkalsdkngaf98ulkandDfdvDdfha147213766","documentType":"Listing Representation","documentName":"Listing-Representation-Single-PP-v4.2_AMACOR.pdf","uploadDate":"2024-01-30T20:14:26.943Z"}]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=108247&IDKEY=k0e98hfalksuf098fnsdalfkjfoijmn4309JLKJFjlaksjfla9f149272613","documentType":"Project Description","documentName":"VCS_PROJ_DESC_DRAFT_4904_22DEC2023 (1) (1).pdf","uploadDate":"2024-02-26T17:18:27.31Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=132110&IDKEY=s98klasmf8jflkasf8098afnasfkj98f0a9sfsakjflsakjf8ds182179690","documentType":"Project Description","documentName":"VCS PD 4904 16APR2025_public version.pdf","uploadDate":"2025-05-21T18:58:48.693Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=121336&IDKEY=k