{"resourceIdentifier":"5443","resourceName":"SANTOS LANDFILL GAS PROJECT","description":"The proposed VCS project activity titled “Santos Landfill Gas Project” (hereinafter termed “project activity”) encompasses the promotion of collection and destruction/utilization of landfill gas (LFG) (rich in methane) at the landfill site hereby termed “Terrestre landfill” through combustion in a high temperature enclosed flare and utilization of collected LFG as gaseous fuel in engine-generator sets (engines) of an electricity generation infrastructure (with final total combined nameplate installed capacity of about 5.716 MW).","location":{"latitude":-23.884144,"longitude":-23.884144},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2025-04-21","endExclusive":"2025-05-22","endInclusive":"2025-05-21"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"5443"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Sao Paulo"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Raizen Gera Desenvolvedora S.A."},{"type":"string","value":"Brazil"},{"type":"string","value":"+55 (21) 2530-0591"},{"type":"string","value":"guilherme.bahiana@grupogera.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"391939"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"28/11/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/06/2023 - 31/05/2030"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS