{"resourceIdentifier":"4382","resourceName":"MSW to Compost through BSF Rearing process","description":"The proposed project activity is a step towards supporting the implementation and installation of Municipal Solid Waste (MSW) to Compost through BSF Rearing process facility in India. The project proponent for this Project Activity is Ento Protein Private Limited, Ento Proteins is the one of the India’s first start up focused on developing new sources of insect based animal protein by recycling organic wet waste and other agro waste. The compost plant is situated at Pachanady SWM, Mangaluru. They developed technologies to produce BSF (Black Soldier Fly) insect meal at large scale and compost.","location":{"latitude":15.317300,"longitude":75.713900},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-05-16","endExclusive":"2023-06-16","endInclusive":"2023-06-15"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4382"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"karanataka"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Ento Proteins Private Limited"},{"type":"string","value":"Karnataka, India"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"4382"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"43793"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.F."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Earthood Services Limited"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"13/12/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 09/12/2021 - 08/12/2028"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","descrip