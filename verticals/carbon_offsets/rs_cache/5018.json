{"resourceIdentifier":"5018","resourceName":"Zhejiang Hengxin PET Recycling Project","description":"Zhejiang Hengxin PET Recycling Protect aims to produce PET flakes by recycling and processing post-consumer PET bottles, to replace the same amount of PET products produced from raw materials. It is planned that 100,000 tons of post-consumer PET bottles per year will be recycled into 85,500 tons of PET flakes at maximum production capacity. The Project is located in the Longyou Industrial Park, Longyou County, Quzhou City, Zhejiang Province, China. The Project is developed and operated by Zhejiang Hengxin Power Co.,Ltd..","location":{"latitude":29.116803,"longitude":119.252499},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2024-05-20","endExclusive":"2024-06-20","endInclusive":"2024-06-19"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"5018"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Zhejiang Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Zhejiang Hengxin Power Co.,Ltd."},{"type":"string","value":"Zhejiang Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"55396"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"VMR0007"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"01/05/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 04/09/2023 - 03/09/2030"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.as