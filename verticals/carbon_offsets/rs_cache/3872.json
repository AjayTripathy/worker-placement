{"resourceIdentifier":"3872","resourceName":"Yangxiang AWMS GHG Mitigation Project In Shandong Province","description":"Yangxiang AWMS GHG Mitigation Project in Shandong province (hereinafter as “the proposed project”) locates in Heze City City and Jinan City, Jining City, Qingdao City,Tai'an City, Shandong province, China. The proposed project introduces new animal waste management systems to treat the manure from 9 swine farms in Shandong Province. Each subsidiary swine farm will install one animal waste management system, and the manure is treated on site. The purpose of the project activity is to treat the manure and wastewater to avoid methane emissions generated in the baseline uncovered anaerobic lagoons.","location":{"latitude":35.227654,"longitude":115.074245},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-01-09","endExclusive":"2023-02-09","endInclusive":"2023-02-08"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3872"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Shandong Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Henan Yangxiang Breeding Co., Ltd"},{"type":"string","value":"Henan Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3872"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"119057"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.D.,AMS-III.F."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Carbon Check (India) Private Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"04/01/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/04/2021 - 31/03/2031"}]}]}],"doc