{"resourceIdentifier":"3637","resourceName":"Kayseri Landfill Gas to Power Generation Project","description":"Kayseri Landfill Gas to Power Generation Project (hereafter referred to as the project) is located at Kayseri Landfill Site in Kocasinan District, Kayseri Province Turkey. The project is owned by R Enerji Elektrik Üretim A.Ş. (hereafter referred to as the project owner). The project started construction on 24/06/2021 and started operation on 30/06/2021. The total installed capacity will be 9.257 MWm/ 9 MWe [(5x1,605)+1,232] MWm/ [(5x1,560)+1,200] MWe], consisting of 6 sets of generators. The feed-in electricity is estimated to be 675,000 MWh during the fixed 10 years crediting period.","location":{"latitude":38.776107,"longitude":35.304897},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-08-23","endExclusive":"2022-09-23","endInclusive":"2022-09-22"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3637"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Kayseri"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"R Enerji Elektrik Üretim A.Ş."},{"type":"string","value":"Kayseri, Turkey"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"157255"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Energy industries (renewable/non-renewable sources)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"25/11/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 30/06/2021 - 29/06/2028"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS P