{"resourceIdentifier":"4732","resourceName":"NatureRe assisted natural regeneration project in degraded lands in Antioquia, Colombia","description":"The NatureRe project is a grouped project that seeks to sustainably manage 4,500 ha, within which it is estimated there is potential to restore approximately 2,925 ha. This area corresponds to livestock-degraded lands in the Antioquia Department (Colombia), in three subregions: Magdalena Medio, Bajo Cauca, and Nordeste. The project aims to restore native forest species by applying different ANR models.","location":{"latitude":6.382592,"longitude":-74.697917},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2026-01-21","endExclusive":"2026-02-21","endInclusive":"2026-02-20"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4732"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Antioquia"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"37467"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"ARR"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AR-ACM0003"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"4500 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Colombian Institute for Technical Standards and Certification (ICONTEC)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"23/04/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/10/2022 - 30/09/2062"}]}]},{"programCode":"CCB","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple