{"resourceIdentifier":"2468","resourceName":"Gaizhou Landfill Gas Power Generation Project","description":"The project is located at Gaizhou Landfill Site in Gujiazi Village, Tuandian, Gaizhou City, Liaoning Province, P.R China. The project is a landfill gas collection and utilization project. The project will collect landfill gas (methane) and use it for electricity generation and the installed capacity is 3 MW. The power generated by the plant is delivered to Northeast China Power Grid. The annual power generation is expected to be 24,000 MWh. The annual emission reduction is expected to be 134,000 tons.","location":{"latitude":40.431106,"longitude":122.429164},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2021-04-21","endExclusive":"2021-05-22","endInclusive":"2021-05-21"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2468"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Liaoning Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Gaizhou Xinzhongshui Environmental Protection Technology Co., Ltd."},{"type":"string","value":"Liaoning Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2468"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"128590"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"23/07/2021"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 05/01/2021 - 04/01/2031"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VC