{"resourceIdentifier":"2402","resourceName":"Linshu Biogas Recovery and Power Generation Project","description":"The Linshu Biogas Recovery and Power Generation Project is located in Linshu Town, Shandong Province, China.\r\nThe proposed project activity will install a series of wastewater treatment equipment, biogas recovery and purification equipment, biogas generator and waste heat boiler to utilize the biogas to generate electricity and heat. The electricity and heat generated will be used for the production of Jinyimeng Group to replace those from NCPG and coal boilers.","location":{"latitude":34.914704,"longitude":118.571882},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2021-01-11","endExclusive":"2021-02-11","endInclusive":"2021-02-10"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2402"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Shandong Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"VPOWER New Energy Technology (LinYi) LTD"},{"type":"string","value":"Shan Dong, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2402"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"359691"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0014"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"04/08/2021"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 20/09/2019 - 19/09/2026"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.