{"resourceIdentifier":"640","resourceName":"Flathead Electric Cooperative Landfill Gas to Energy Project","description":"The Flathead County Landfill Gas-to-Energy Project involves the extraction of landfill gas from a municipal solid waste landfill and its destruction in an onsite engine-generator set or flare. The Project consists of the installation of multiple gas extraction wells, associated piping, metering equipment, a gas handling skid, and a 1.6-MW rated landfill gas engine-generator which is interconnected to the grid. The Project activity does not include a renewable energy component.","location":{"latitude":48.309231,"longitude":-114.338651},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"640"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"MT"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Flathead Electric Cooperative, Inc."},{"type":"string","value":"MT, United States"},{"type":"string","value":"406-751-4468"},{"type":"string","value":"j.goroski@flathead.coop"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Verification approval requested"},{"type":"assetSearchLink","value":null,"targetId":"640"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"14510"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"GHD Limited"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"24/06/2011"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"CREDITING PERIOD HAS EXPIRED, 26/06/2009 - 25/06/2019"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REG