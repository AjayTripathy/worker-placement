{"resourceIdentifier":"2679","resourceName":"Jiyuan MSW Landfill Site LFG Recovery to Power Project","description":"Jiyuan MSW Landfill Site LFG Recovery to Power Project (hereafter referred to as “the project”) is developed by Shanghai BCCY Industry Co., Ltd (hereafter referred to as the project owner). It is located in Jiyuan City MSW landfill site, southwest of Zhicheng Town and northeast of Zaoshuling Village, 10km away from downtown of Jiyuan City, Henan Province, P.R. China. The project objective is to collect the landfill gas (LFG) from Jiyuan waste disposal site (hereafter referred to as “the landfill site”) and utilize it to generate electricity.","location":{"latitude":35.001387,"longitude":112.546109},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2021-11-29","endExclusive":"2021-12-30","endInclusive":"2021-12-29"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2679"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Henan Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Henan BCCY Environmental Energy CO.,LTD."},{"type":"string","value":"Henan, China"},{"type":"string","value":"86 371 6552 1782"},{"type":"string","value":"lwang@bccynewpower.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2679"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"32397"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-I.D.,AMS-III.G."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"09/09/2022"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"strin