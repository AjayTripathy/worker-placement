{"resourceIdentifier":"162","resourceName":"Her-Fried Utilization of Coalmine Methane","description":"In the German Ruhr district there have been industrial hard coal mining activities for more than hundred years. In the whole area there are more than 100 known shafts. The coal-mine-methane that is captured in this project would otherwise escape directly through cracks and fissures and diffuse through the overburden rocks into the atmosphere. The project couples the production of power with the conversion of the 21-times stronger green-house-gas methane into carbon dioxide.","location":{"latitude":51.562852,"longitude":7.254925},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"162"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Carbon-TF B.V."},{"type":"string","value":"Cordoba, Argentina"},{"type":"string","value":"www.arcor.com.ar"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"162"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"57348"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Fugitive emissions from fuels (solid, oil and gas)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.D."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"TÜV NORD CERT GmbH"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[]},{"code":"VCS_ISSUANCE_DOCUMENTS","description":"VCS Issuance Documents","documents":[]},{"code":"VCS_OTHER_DOCUMENTS","description":"VCS Other Documents","documents":[]}],"childResources":