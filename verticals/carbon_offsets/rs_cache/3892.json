{"resourceIdentifier":"3892","resourceName":"RESTORATION OF HOMESTEAD LAND OF POOR RURAL COMMUNITIES IN ASSAM & MEGHALAYA","description":"The proposed Afforestation, Reforestation and Revegetation (ARR) VCS project in the districts  of these two states, aims at bringing sustainable development of the local communities contributing to the whole carbon offset mitigation by restoring 9000 Ha. of farmland. The area will be treated with plantations in Kamrup and Goalpara districts in the state of Assam and Ri Bhoi district in the state of Meghalaya. The project aims to improve its agriculture practices by incorporating crop diversification, inter-cropping, progressive reduction in the use of synthetic chemicals and further replacing it with organic compost like vermiwash, handikhatta, jibaamrit, etc while setting up composting units to promote the recycling of biomass.","location":{"latitude":26.148043,"longitude":91.731377},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-03-17","endExclusive":"2023-04-17","endInclusive":"2023-04-16"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3892"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"170282"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"ALM; ARR"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AR-ACM0003"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"9000 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"4K Earth Science Private Limited"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"21/08/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/01/2024 - 31/12/2043"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=79563&IDKEY=00e98hfalksuf098fnsdalfkjfoijmn4309JLKJFjlaksjfla9L109717377","documentType":"Draft Project Description","documentName":"VCS_PROJ_DESC_DRAFT_3892_19JUL2022.pdf","uploadDate":"2022-11-28T18:42:23.723Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=77267&IDKEY=9097809fdslkjf09rndasfufd098asodfjlkduf09nm23mrn872106551193","documentType":"Listing Representation","documentName":"Listing-Representation-signed.pdf","uploadDate":"2022-10-29T06:50:56.35Z"}]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=117507&IDKEY=3097809fdslkjf09rndasfufd098asodfjlkduf09nm23mrn870162042153","documentType":"Project Description","documentName":"VSC_PD_Rangasang_FCF_V6.2_Clean Version.pdf","uploadDate":"2024-08-21T20:39:21.953Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=117502&IDKEY=3iofj09234rm9oq4jndsma80vcalksdjf98cxkjaf90823nmq3162035258","documentType":"Validation Report","documentName":"Final FVR_Rangsang_V03_Clean version (1).pdf","uploadDate":"2024-08-21T20:29:10.84Z"}]},{"code":"VCS_ISSUANCE_DOCUMENTS","description":"VCS Issuance Documents","documents":[]},{"code":"VCS_OTHER_DOCUMENTS","description":"VCS Other Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=77266&IDKEY=ulksjoiuwqowrnoiuomnckjashoufifmln902309ksdflku098d106549814","documentType":"Communications Agreement","documentName":"Veera communication agreement_signed.pdf","uploadDate":"2022-10-29T06:50:31.213Z"},{"uri":"https://registry.verra.org/mymodule/Proj