{"resourceIdentifier":"3077","resourceName":"Huojia County Second MSW Landfill Site LFG Pollution Treatment and Comprehensive Utilization Project","description":"Huojia County Second MSW Landfill Site LFG Pollution Treatment and Comprehensive Utilization Project (hereafter referred to as the project) is located in Beizhuang Village, Xuying Town, Huojia County, Xinxiang City, Henan Province, P.R. China. The project is constructed and operated by Huojia County BCCY New Energy Co., Ltd. The objective is to collect the landfill gas (LFG) from Huojia County Second MSW landfill site (hereafter referred to as Huojia Second landfill site) and utilize it to generate electricity.","location":{"latitude":35.163026,"longitude":113.538358},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-05-11","endExclusive":"2022-06-11","endInclusive":"2022-06-10"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3077"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Henan Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Henan BCCY Environmental Energy CO.,LTD."},{"type":"string","value":"Henan, China"},{"type":"string","value":"86 371 6552 1782"},{"type":"string","value":"lwang@bccynewpower.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"25744"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Energy industries (renewable/non-renewable sources)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-I.D.,AMS-III.G."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"22/02/2023"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 27