{"resourceIdentifier":"3688","resourceName":"Shandong Xiantan Composting Project","description":"The project introduced a set of organic fertilizers production lines with an annual output of 40,000 tons to treat the manure from the chicken farms in Yantai City, Shandong Province. The purpose of the project activity is to avoid methane emissions through controlled aerobic treatment by composting of manure. It was designed to treat the chicken manure in Yantai City to produce organic fertilizer. It is estimated that approximately 114,000 tons of manure can be composted aerobically annually for this project.","location":{"latitude":37.234777,"longitude":121.609468},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-01-13","endExclusive":"2023-02-13","endInclusive":"2023-02-12"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3688"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Shandong Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Shandong Xiantan Biotechnology Co Ltd"},{"type":"string","value":"Shandong Province, China"},{"type":"string","value":"05355550960"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3688"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"55293"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.D.,AMS-III.F."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"18/10/2023"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/05/2021 - 30/04/2031"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pip