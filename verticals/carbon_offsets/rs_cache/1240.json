{"resourceIdentifier":"1240","resourceName":"Joburg Landfill Gas to Energy Project","description":"The Joburg Landfill Gas to Energy Project developed by ENER-G Systems Joburg (Pty) Ltd is a landfill gas (LFG) collection and utilisation project located at the Johannesburg landfill sites in South Africa.The objective of the project is to collect and destruct/utilise the landfill gas (LFG) generated at five of the Johannesburg landfill sites. The project activity will consist of two distinct stages. In the first stage, LFG will be captured and destroyed by using a LFG flare, while in the second stage the captured LFG will be fed to the LFG flare and a modular electricity generation plant. The purpose of LFG flaring is to dispose of the flammable constituents, particularly methane, safely and to control odour nuisance, health risks and adverse environmental impacts. The generator once installed will combust the methane in the LFG to produce electricity for export to a local power purchaser.","location":{"latitude":-26.094718,"longitude":28.120277},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"1240"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Gauteng"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Energy Joburg RF (PTY) Limited"},{"type":"string","value":"Bogotá, Colombia"},{"type":"string","value":"05713002832"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Verification approval requested"},{"type":"assetSearchLink","value":null,"targetId":"1240"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"637423"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Carbon Check (Pty) Ltd"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"04/06/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 27/05/2021 - 26/05/2031"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=40182&IDKEY=s903q4jsafkasjfu90amnmasdfkaidflnmdf9348r09dmfasdf055410978","documentType":"Project Description","documentName":"PROJ_DESC_1240_21JAN2014.pdf","uploadDate":"2017-03-30T11:52:36Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=45439&IDKEY=m903q4jsafkasjfu90amnmasdfkaidflnmdf9348r09dmfasdf962660381","documentType":"Project Description","documentName":"CDM_PROJ_DESC_1240_06NOV2012.pdf","uploadDate":"2017-03-30T11:52:37Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=86236&IDKEY=q903q4jsafkasjfu90amnmasdfkaidflnmdf9348r09dmfasdff118919444","documentType":"Project Description","documentName":"2023-03-03 Jhb LFG VCS PD v9 clean.pdf","uploadDate":"2023-03-10T15:45:03.843Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=40183&IDKEY=j98klasmf8jflkasf8098afnasfkj98f0a9sfsakjflsakjf8dk55412357","documentType":"Registration Representation","documentName":"PP_REG_REP_1240_03FEB2014.pdf","uploadDate":"2017-03-30T11:52:36Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=44595&IDKEY=lkjalskjf098234kj28098sfkjlf098098kl32lasjdflkj909s61496505","documentType":"Validation Report","documentName":"VALID_REP_1240_23JAN2014.pdf","uploadDate":"2017-03-30T11:52:36Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=45441&IDKEY=mlksjoiuwqowrnoiuomnckjashoufifmln902309ksdflku098m62663139","documentType":"Validation 