{"resourceIdentifier":"684","resourceName":"Orange County Methane Recovery and Destruction Project","description":"The Project is a voluntary carbon emission reduction activity in the United States of America that captures and destroys fugitive methane and other greenhouse gases (GHGs) from a closed former waste handling and disposal (solid waste management) site. The LFG extraction system utilises a collection system, including gas wells, conveyance piping, and a condensate handling system.  Located in Orange County, New York near the Town of Goshen, the Project will capture and combust LFG, via an open flare, that would otherwise have been released to the atmosphere.","location":{"latitude":41.389488,"longitude":-74.399702},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"684"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"NY"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"MP Orange, LLC"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"684"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"67972"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"First Environment, Inc. (First Environment)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"09/09/2011"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"CREDITING PERIOD HAS EXPIRED, 01/01/2009 - 31/12/2018"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","docume