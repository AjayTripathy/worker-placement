{"resourceIdentifier":"2452","resourceName":"Laizhou Landfill Gas Power Generation Project","description":"The project is located at Laizhou Landfill Site in Houwangmen Village, Chengguo Town, Laizhou City, Shandong Province, P.R China. The project is a landfill gas collection and utilization project. The project will collect landfill gas (methane) and use it for electricity generation and the installed capacity is 2 MW. The power generated by plant is delivered to North China Power Grid. The annual power generation is expected to be 16,000 MWh. The annual emission reduction is expected to be 78,000 tons.","location":{"latitude":37.204166,"longitude":120.013609},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2021-02-24","endExclusive":"2021-03-27","endInclusive":"2021-03-26"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2452"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Shandong"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Laizhou Xinzhongshui Environmental Protection Technology Co., Ltd."},{"type":"string","value":"Shandong Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2452"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"78184"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"24/06/2021"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 18/05/2019 - 17/05/2029"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"ur