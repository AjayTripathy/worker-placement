{"resourceIdentifier":"1382","resourceName":"The Envira Amazonia Project - A Tropical Forest Conservation Project in Acre, Brazil","description":"The Envira Amazonia Project is a VCS and CCBS designed REDD+ project in the State of Acre, Brazil which aims to protect up to 200,000 hectares of tropical rainforest. Furthermore, the Envira Amazonia Project will simultaneously preserve rich biodiversity and a wide range of ecosystem services, provide direct benefits to local communities, and mitigate the release of ~12.6 million metric tonnes of carbon dioxide emissions over the first 10 years of the Project.","location":{"latitude":-8.847445,"longitude":-70.177176},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2026-03-19","endExclusive":"2026-04-19","endInclusive":"2026-04-18"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"1382"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Acre"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Verification approval requested"},{"type":"assetSearchLink","value":null,"targetId":"1382"},{"type":"bufferSearchLink","value":null,"targetId":"1382"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"1259646"}]},{"code":"TOTAL_BUFFER_POOL_CREDITS","values":[{"type":"integer","value":4503981}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"REDD"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"VM0007"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"39301 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Aster Global Environmental Solutions Inc."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"