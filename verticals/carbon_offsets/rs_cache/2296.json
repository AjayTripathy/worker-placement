{"resourceIdentifier":"2296","resourceName":"CYY Global Plus Wastewater Treatment and Biogas Utilization Project","description":"The project activity is implemented in a greenfield location. The project involves the installation of three covered lagoons in order to treat the wastewater from the starch factory and capture biogas for utilization. The biogas generated shall be partially replaced heavy fuel oil used in the thermal oil boiler and fully used as fuel in gas engine for electricity generation. The electricity shall be internally consumed.","location":{"latitude":14.489446,"longitude":103.705405},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2020-06-01","endExclusive":"2020-07-02","endInclusive":"2020-07-01"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2296"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Surin Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"CYY Global Plus Co., Ltd."},{"type":"string","value":"Surin Province, Thailand"},{"type":"string","value":"+66 44 558 851"},{"type":"string","value":"cyygb_2017ph@hotmail.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2296"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"124097"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0014"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"4K Earth Science Private Limited"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"14/05/2021"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 15/09/2019 - 14/09/2026"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents