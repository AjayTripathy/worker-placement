{"resourceIdentifier":"4126","resourceName":"Community Restoration of Native Ecosystems in Ghana","description":"Community Restoration of Native Ecosystems in Ghana is a landscape-scale reforestation project designed by Three Trees and Climate Investment Partners that aims to increase tree cover in various regions of rural Ghana by planting native species on degraded communal lands or forest reserves. This reforestation will contribute to wildlife habitat or corridors, improve water infiltration, control erosion, and sequester carbon, among other ecosystem services. This grouped project is targeting a scale of up to 50,000 hectares.","location":{"latitude":6.934910,"longitude":0.924246},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-01-31","endExclusive":"2023-03-03","endInclusive":"2023-03-02"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4126"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"92"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"ARR"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AR-ACM0003"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"5 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"AENOR CONFIA, S.A. (UNIPERSONAL)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"25/06/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 31/01/2023 - 30/01/2063"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/m