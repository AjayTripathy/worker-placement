{"resourceIdentifier":"1166","resourceName":"Nanba Associated Gas Processing Plant and the Auxiliary Engineering","description":"The Nanba Associated Gas Processing Plant and the Auxiliary Engineering is located in Daqing City, Heilongjiang Province, People¡¯s Republic of China. The primary objective of the proposed project is to recover and utilize the associated gas from oil wells in the Second Oil Production Plant of Sanan Oilfield that would otherwise be vented, to process into dry gas and condensate. The oil field development of the Second Oil Production Plant of Sanan Oilfield does not apply and will not apply the gas-lift technology, and there is no gas injection infrastructure at the project site.","location":{"latitude":46.550100,"longitude":125.015200},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"1166"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Heilongjiang"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Daqing Oilfield Co., Ltd."}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"1166"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"301731"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Fugitive emissions from fuels (solid, oil and gas)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AM0009"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"ERM Certification and Verification Services Limited"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"10/10/2014"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"CREDITING PERIOD HAS EXPIRED, 29/05/2012 - 28/05/2022"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":