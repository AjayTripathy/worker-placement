{"resourceIdentifier":"80","resourceName":"Greenville County Landfill Gas Utilization Project","description":"The Greenville County Landfill Gas Utilization Project is a landfill gas collection and utilization project taking place at the Enoree landfill in Greer, South Carolina.    The project activity involves capturing methane for utilization in a 3.2 MW modular electricity generation plant.  Excess methane is combusted in an open flare.  The objective of the Project is to convert fugitive methane into CO2, thereby reducing its global warming effect.","location":{"latitude":34.808333,"longitude":-82.178611},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"80"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"SC"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Greenville Gas Producers, LLC"},{"type":"string","value":"NY, United States"},{"type":"string","value":"212-356-0181"},{"type":"string","value":"amy.watson@ecosecurities.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"80"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"145008"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Det Norske Veritas Climate Change Services AS (DNV)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"19/06/2009"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"2nd, 01/08/2017 - 31/07/2027"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registrat