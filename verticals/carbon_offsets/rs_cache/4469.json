{"resourceIdentifier":"4469","resourceName":"Zonguldak Landfill Gas to Electricity Project","description":"Zonguldak Landfill Gas to Electricity Project is located at Zonguldak Landfill Site in Sofular Neighborhood, Central District, Zonguldak Province Turkey. The project is owned by Arel Yenilenebilir Enerji Teknolojileri ve Elektrik Üretimi Ltd. Şti. The facility started operation on 28/06/2021 and the feed in electricity is estimated to be 33,113 MWh / year at full capacity during the 7-year crediting period. The project is expected to reduce 79,423 tCO2e/y annually in the first 7-year crediting period between starting date of 28/06/2021 and ending date of 27/06/2028.","location":{"latitude":41.449685,"longitude":31.924576},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-10-17","endExclusive":"2023-11-17","endInclusive":"2023-11-16"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4469"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Arel Yenilenebilir Enerji Teknolojileri ve Elektrik Üretim Ltd. Şti."},{"type":"string","value":"ANKARA, Turkey"},{"type":"string","value":"+90 312 435 80 32"},{"type":"string","value":"damla@arelenerji.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"4469"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"71518"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Energy industries (renewable/non-renewable sources)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"03/10/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/01/2