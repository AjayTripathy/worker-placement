{"resourceIdentifier":"4014","resourceName":"Sinop Landfill Gas to Electricity Project","description":"Sinop Landfill Gas to Electricity Project is located at Sinop Landfill Site in Hacioglu Neighborhood, Central District, Sinop Province Turkey. The project is owned by Biokütle Enerji Elektrik Üretim A.Ş. The facility started operation on 29/06/2021 and the feed-in electricity is estimated to be 21,210 MWh / year  at full capacity during the 7-year crediting period. The project is expected to reduce 30,789 tCO2e/y annually in the first 7-year crediting period between commission date of 29/06/2022 and ending date of 28/06/2028.","location":{"latitude":41.949123,"longitude":35.036504},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-01-12","endExclusive":"2023-02-12","endInclusive":"2023-02-11"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4014"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Biokütle Enerji Elektrik Üretim Anonim Şirketi"},{"type":"string","value":"Antalya, Turkey"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"4014"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"37688"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-I.D.,AMS-III.G."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"25/06/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/07/2021 - 30/06/2028"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/Pr