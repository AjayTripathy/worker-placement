{"resourceIdentifier":"947","resourceName":"Spartanburg County Landfill Gas Combustion Project","description":"The Project consists of the voluntary destruction of landfill gas from an expanded landfill gas collection system at the Wellford Landfill in Spartanburg County, South Carolina.  The Project consists of three phases: (1) expansion of the existing landfill gas collection system and destruction of landfill gas in an existing flare; (2) implementation of a beneficial use project by which landfill gas was destroyed in off-site boilers at the Milliken Dewey Chemical plant: and (3) implementation of another beneficial use project by which landfill gas was used to generate electricity.","location":{"latitude":35.001193,"longitude":-82.130420},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"947"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"SC"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"947"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"75977"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Ruby Canyon Engineering"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"2nd, 15/06/2020 - 14/06/2030"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://reg