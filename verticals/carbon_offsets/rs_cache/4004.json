{"resourceIdentifier":"4004","resourceName":"The Native Ecosystem Restoration in Nicaragua Project","description":"The objective of the Native Ecosystem Restoration in Nicaragua Project is to reforest an area of around 20,000 hectares, starting with the acquisition of 6,000 hectares of unused or under-used, degraded land in Nicaragua currently managed as abandoned or cattle pasture grazed at very low densities, and restore this ecosystem with native trees in order to sequester carbon dioxide. The degraded land will thus be rehabilitated with native tree cover, and over time biodiversity and local hydrology will be restored. The grouped Project will control erosion, regenerate soil health, and increase water infiltration, consequently improving ground water levels in the area, as well as provide local employment opportunities. Most land being considered is in the Central and Pacific regions of Nicaragua, but all regions of the country with degraded cattle pasture are eligible.","location":{"latitude":12.110369,"longitude":-86.369667},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-01-09","endExclusive":"2023-02-09","endInclusive":"2023-02-08"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4004"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"164"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"ARR"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AR-ACM0003"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"11 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"AENOR CONFIA, S.A. (UNIPERSONAL)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"22/01/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 11/07/2022 - 10/07/2062"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=80913&IDKEY=8q934lkmsad39asjdkfj90qlkalsdkngaf98ulkandDfdvDdfhs111579027","documentType":"Draft Project Description","documentName":"The Native Ecosystem Restoration in Nicaragua PDD 12.09.22.pdf","uploadDate":"2022-12-16T15:18:36.433Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=80621&IDKEY=8kjalskjf098234kj28098sfkjlf098098kl32lasjdflkj909j111176359","documentType":"Listing Representation","documentName":"VCS-Listing-Representation-Multiple-Representors-v4.1 (for Nicaragua ARR Project)_Corrected.pdf","uploadDate":"2022-12-13T15:20:42.957Z"}]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=126334&IDKEY=2kjalskjf098234kj28098sfkjlf098098kl32lasjdflkj9092174214586","documentType":"Project Description","documentName":"The Native Ecosystem Restoration in Nicaragua PDD 11.12.24_Clean.pdf","uploadDate":"2025-01-22T13:09:21.267Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=113041&IDKEY=klksjoiuwqowrnoiuomnckjashoufifmln902309ksdflku0980155883539","documentType":"Registration Representation","documentName":"VCS-Registration-Representation-CIP-ST_Signed.pdf","uploadDate":"2024-05-22T18:16:42.93Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=126333&IDKEY=a98klasmf8jflkasf8098afnasfkj98f0a9sfsakjflsakjf8df174213207","documentType":"Validation Report","documentName":"22112024_vcs-validation-report-Restoration_Nicaragua_Clean.pdf","uploadDa