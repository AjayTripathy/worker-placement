{"resourceIdentifier":"613","resourceName":"North Antelope Rochelle Mine CMM Capture and Use Project: Phase II - Porcupine Project","description":"The Porcupine project consists of 26 CMM extraction wells and pipeline infrastructure to capture coal mine methane and deliver it to a gas pipeline - in the absence of this project mine methane would have been vented into the atmosphere from the coal seam during the mining process. The project is located immediately north and north west of the North Antelope Rochelle Mine in Wyoming.","location":{"latitude":43.550529,"longitude":-105.265331},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"613"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"WY"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Camco International Group, Inc."},{"type":"string","value":"PA, United States"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"613"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"135102"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Mining/mineral production"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"VMR0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Det Norske Veritas Climate Change Services AS (DNV)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=42738&IDKEY=aiofj09234rm9oq4jndsma80vcalksdjf98cxkjaf90823nmq3r58935702","documentType":"Project Descriptio