{"resourceIdentifier":"5030","resourceName":"SEA FOREST ENTERIC METHANE REDUCTION IN AUSTRALIA","description":"The Sea Forest enteric methane reduction in Australia grouped project, referred to hereafter as the project, aims to reduce greenhouse gas emissions produced through enteric methane emissions by Australian beef, dairy and other livestock by introducing SeaFeedTM, a methane abating livestock feed supplement based on bromoform as the active ingredient, into the feeding of ruminants such as beef cattle, dairy cattle, and sheep located in Australian States and Territories by livestock producers (also referred to as farms).","location":{"latitude":-41.429164,"longitude":146.555831},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2024-06-18","endExclusive":"2024-07-19","endInclusive":"2024-07-18"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"5030"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Sea Forest Limited"},{"type":"string","value":"TAS, Australia"},{"type":"string","value":"+57 3112003422"},{"type":"string","value":"bj@seaforest.com.au"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"1217128"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Livestock, enteric fermentation, and manure management"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"VM0041"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Earthood Services Limited"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"11/02/2026"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 08/02/2024 - 07/02/2031"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDo