{"resourceIdentifier":"2840","resourceName":"Nanzhao County MSW Landfill Site LFG Pollution Treatment and Comprehensive Utilization Project","description":"Nanzhao County MSW Landfill Site LFG Pollution Treatment and Comprehensive Utilization Project (hereafter referred to as the project) is located in Dongzhuang Village, Chengjiao town, Nanzhao County, Nanyang City, Henan Province, P.R. China. The project is invested, constructed and operated by Nanzhao County Baichang New Energy Co., Ltd. The objective is to collect the landfill gas (LFG) from Nanzhao County MSW landfill site (hereafter referred to as Nanzhao landfill site) and utilize it to generate electricity.","location":{"latitude":33.464842,"longitude":112.522644},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-07-01","endExclusive":"2022-08-01","endInclusive":"2022-07-31"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2840"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Henan Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Henan BCCY Environmental Energy CO.,LTD."},{"type":"string","value":"Henan, China"},{"type":"string","value":"86 371 6552 1782"},{"type":"string","value":"lwang@bccynewpower.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2840"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"81259"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Energy industries (renewable/non-renewable sources)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"31/01/2023"}]},{"code":"CREDIT_PERIOD_INFO","v