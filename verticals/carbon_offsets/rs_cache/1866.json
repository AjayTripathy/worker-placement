{"resourceIdentifier":"1866","resourceName":"XinJiang Makit County Afforestation Carbon Sequestration Project","description":"XinJiang Makit County Afforestation Carbon Sequestration Project (here after “the project”) is located in Makit County, Xinjiang Uygur Autonomous Region of China, whose aim is to increase carbon sequestration and contribute to local sustainable development by planting trees on the desert lands. The project proponent is Makit Base Junlian Cotton Industry Co., Ltd. 6,697.84 ha of forest is to be planted by direct planting on desert lands in Makit County. There is no natural renewal and reforestation before the project. The implementation of the project would generate GHG emission removals and improve local environment through growing of the trees, enhance the capabilities of local communities and residents by providing their relevant technical skills and training, and increase local biodiversity as a result of establishing a forest of native trees (Populus alba var, Haloxylon ammodendron, Elaeagnus angustifolia Linn).","location":{"latitude":38.858983,"longitude":77.806055},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"1866"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"XinJiang"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Makit Base Junlian Cotton Industry Co., Ltd."},{"type":"string","value":"China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"On Hold - see notification letter"},{"type":"assetSearchLink","value":null,"targetId":"1866"},{"type":"bufferSearchLink","value":null,"targetId":"1866"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"90393"}]},{"code":"TOTAL_BUFFER_POOL_CREDITS","values":[{"type":"integer","value":66328}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"ARR; IFM; REDD"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AR-ACM0003"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"6697 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"TÜV NORD CERT GmbH"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 10/03/2014 - 09/03/2054"}]}]},{"programCode":"CCB","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Makit Base Junlian Cotton Industry Co., Ltd."},{"type":"string","value":"China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"On Hold - see notification letter"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"90393"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Afforestation, Reforestation and Revegetation"}]},{"code":"PROJECT_ACREAGE","values":[{"type":"string","value":"6697 Hectares"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"TÜV NORD CERT GmbH"}]},{"code":"CCB_STANDARD_EDITION_NAME","values":[{"type":"string","value":"CCB Third Edition"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=43977&IDKEY=f0e98hfalksuf098fnsdalfkjfoijmn4309JLKJFjlaksjfla9j60644283","documentType":"Draft Project Description","documentName":"DRAFT_PROJ_DESC_PL1866_25JAN2019.pdf","uploadDate":"2019-10-24T12:40:22Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=38170&IDKEY=0097809fdslkjf09rndasfufd098asodfjlkduf09nm23mrn87852636430","documentType":"Listing Representation","documentName":"PP_LIST_REP_PL1866_09NOV2018.pdf","uploadDate":"2019-10-24T12:40:23Z"}]},{"code":"VCS_REGISTRATIO