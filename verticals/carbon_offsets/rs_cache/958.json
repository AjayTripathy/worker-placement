{"resourceIdentifier":"958","resourceName":"BIOCORREDOR MARTIN SAGRADO REDD+ PROJECT","description":"The project aims to avoid for 80 years deforestation and degradation of forest in an area of 295 654 hectares of primary forest, which is under stress of deforestation and degradation by various drivers and agents, detailed hereafter. The project area is a high conservation value area with many endemic species and several threatened species (flora and fauna) and also boasts vital resources for downstream and surrounding communities. In particular it regulates the water resources in the Huayabamba river basin and the availability of water for downstream communities and cities.","location":{"latitude":-7.533799,"longitude":-77.274974},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2025-04-03","endExclusive":"2025-05-04","endInclusive":"2025-05-03"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"958"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"San Martin province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"The PURE PROJECT SAS"},{"type":"string","value":"Paris, France"},{"type":"string","value":"+56 983 58 42 75"},{"type":"string","value":"carbon@pur.co"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Verification approval requested"},{"type":"assetSearchLink","value":null,"targetId":"958"},{"type":"bufferSearchLink","value":null,"targetId":"958"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"219722"}]},{"code":"TOTAL_BUFFER_POOL_CREDITS","values":[{"type":"integer","value":53536}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Agriculture Forestry and Other Land Use"}]},{"code":"PROJECT_SUBCATERGORY_NAMES","values":[{"type":"string","value":"REDD"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"VM0015"}]},{"code":"PROJECT_ACREAGE