{"resourceIdentifier":"3063","resourceName":"Pengmai Composting Project in Fangcheng County","description":"The project introduces 8 sets of aerobic composting systems to treat the swine manure from Yuanxiang swine farm, Jiazhuang swine farm, Hongmai swine farm, Aoxu swine farm, Hengxing Swine farm, Hengyun Swine farm, Hengfu swine farm and Yinxiang swine farm in Fangcheng county, Nanyang city, Henan Province, China. The purpose of the project activity is to avoid methane emissions through controlled aerobic treatment by composting of swine manure.","location":{"latitude":33.214312,"longitude":112.923145},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-05-19","endExclusive":"2022-06-19","endInclusive":"2022-06-18"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3063"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Henan Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Fangcheng County Pengmai Agriculture and animal husbandry development Co., Ltd."},{"type":"string","value":"Henan Province, China"},{"type":"string","value":"junjunguo850604@126.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3063"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"57425"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.D.,AMS-III.F."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"08/02/2023"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/12/2020 - 30/11/2030"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Docu