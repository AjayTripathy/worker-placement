{"resourceIdentifier":"4707","resourceName":"Danish Crown Methane Destruction Voluntary Carbon Offset Group Project in Denmark  (PTB)","description":"Methane Destruction Grouped Project  initiated by \r\nDanish Crown A/S is a grouped project to mitigate the Greenhouse Gas (GHG) emissions especially methane (CH4) \r\ngas from its supply chain. The project activity instances will be situated in different regions \r\nin Denmark. The project is owned by animal farmers affiliated with Danish Crown but \r\nimplemented by Danish Crown A/S. The project activity consists of anaerobic digestion (AD) \r\nswine slurry treatment and flaring systems. The reduction potential is between 1500 - 3000 tons co2e pr. farm pr. year","location":{"latitude":55.552602,"longitude":11.670605},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2024-06-17","endExclusive":"2024-07-18","endInclusive":"2024-07-17"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"4707"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Multiple Proponents"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"13532"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Livestock, enteric fermentation, and manure management"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.D."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"DNV Business Assurance India Pvt Ltd"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"05/11/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 26/05/2024 - 25/05/2031"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=109577&I