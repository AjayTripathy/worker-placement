{"resourceIdentifier":"5052","resourceName":"Tech-Bank Swine Manure Composting Project in Jiangsu Province","description":"Tech-Bank Swine Manure Composting Project in Jiangsu Province (hereafter referred to as the project) introduces 2 sets of aerobic composting systems to treat the swine manure from Huai’an Huanghuatang swine farm and Yangzhou Huangcheng swine farm in Jiangsu Province, China, which are owned by Tech-Bank Food Co., Ltd. Each subsidiary swine farm will install one aerobic composting system, and the manure is treated on site. The purpose of the project activity is to avoid methane emissions through controlled aerobic treatment by composting of swine manure.","location":{"latitude":33.320486,"longitude":119.386977},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2024-07-24","endExclusive":"2024-08-24","endInclusive":"2024-08-23"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"5052"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Jiangsu Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Tech-Bank Food Co., Ltd."},{"type":"string","value":"Anhui Province, China"},{"type":"string","value":"+86 181 0517 9175"},{"type":"string","value":"1090757710@qq.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"41050"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Livestock, enteric fermentation, and manure management"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.D.,AMS-III.F."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"09/03/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/11/2022 - 31/10/2032"}]}]}],