{"resourceIdentifier":"3871","resourceName":"Yangxiang AWMS GHG Mitigation Project in Liaoning Province","description":"Yangxiang AWMS GHG Mitigation in Liaoning province (hereinafter as “the proposed project”) locates in Shenyang City Xinmin City and Panjin City, Liaoning province, China. The proposed project introduces new animal waste management systems to treat the manure from 2 swine farms in Liaoning Province Each subsidiary swine farm will install one animal waste management system, and the manure is treated on site. The purpose of the project activity is to treat the manure and wastewater to avoid methane emissions generated in the baseline uncovered anaerobic lagoons.","location":{"latitude":42.122467,"longitude":122.493492},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-01-09","endExclusive":"2023-02-09","endInclusive":"2023-02-08"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3871"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Liaoning Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Henan Yangxiang Breeding Co., Ltd"},{"type":"string","value":"Henan Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3871"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"39209"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-III.D.,AMS-III.F."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"Carbon Check (India) Private Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"29/06/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/05/2021 - 30/04/2031"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_D