{"resourceIdentifier":"3766","resourceName":"Gansu Ganzhou Biogas Recovery and Utilization Project","description":"Gansu Ganzhou Biogas Recovery and Utilization Project (hereinafter referred to as the Project) locates in Mingyong Town, Ganzhou District, Zhangye City, Gansu Province, P.R China.The project is to build a centralized anaerobic animal manure treatment system which collects manure waste (dairy cow and sheep) from surrounding livestock farms in Ganzhou district. The project uses animal manure waste as ferment material to produce biogas in the Completely Stirred Tank Reactor (CSTR) type anaerobic digesters. The recovered biogas will be used for electricity generation at the project site. The electricity generated by the project will be delivered to Northwest China Power Grid (NWCPG). The residual waste from the CSTR digesters will be used to produce organic fertilizer at the project site.\r\nThe project is expected to avoid GHG emission of methane through recovery and destruction of biogas. In addition, the electricity generated from the biogas will be delivered to NWCPG to replace equivalent electricity generated by the fossil fuel fired power plants connected to the grid.","location":{"latitude":39.003332,"longitude":100.361936},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-02-09","endExclusive":"2023-03-12","endInclusive":"2023-03-11"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3766"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Gansu"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Gansu Founder Energy Conservation Sci&Tech Service Co., Ltd."},{"type":"string","value":"Gansu Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"33220"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-I.D.,AMS-III.D."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"CTI Certification Co., Ltd."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"01/12/2023"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 01/08/2021 - 31/07/2028"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=74676&IDKEY=90e98hfalksuf098fnsdalfkjfoijmn4309JLKJFjlaksjfla9102978204","documentType":"Draft Project Description","documentName":"01-Ganzhou_VCS PD_V01.pdf","uploadDate":"2022-09-27T09:41:08.593Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=74677&IDKEY=fq934lkmsad39asjdkfj90qlkalsdkngaf98ulkandDfdvDdfhq102979583","documentType":"Listing Representation","documentName":"02-Ganzhou_VCS-Listing-Representation-Single-Representor-v4.1.pdf","uploadDate":"2022-09-27T09:43:04.17Z"}]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=103219&IDKEY=viofj09234rm9oq4jndsma80vcalksdjf98cxkjaf90823nmq3c142339001","documentType":"Project Description","documentName":"01-Ganzhou Biogas_VCS JPM_20210801-20221231 V2.2 20231201-clean.pdf","uploadDate":"2023-12-01T18:23:14.677Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=103221&IDKEY=skjalskjf098234kj28098sfkjlf098098kl32lasjdflkj909f142341759","documentType":"Validation Report","documentName":"2023-12-01 VCS-Joint-VAL-VER_FVR_Gaotai Biogas_clean.pdf","uploadDate":"2023-12-01T18:26:05.013Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=93633&IDKEY=9iofj09234rm9oq4jndsma80vcalksdjf98cxkjaf90823nmq38