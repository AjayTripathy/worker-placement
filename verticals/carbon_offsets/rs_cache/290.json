{"resourceIdentifier":"290","resourceName":"Lee County Waste To Energy Facility 2007 Capital Expansion Project VCU","description":"Installation of a new 636 ton per day combustion unit at the Lee County Waste To Energy Facility in Fort Myers, Florida. Heat from the incineration of municipal solid waste in the mass burn municipal waste combustion unit is captured and used to create steam to generate electricity.  By combusting waste in a waste to energy facility, methane emissions that would have been produced if the waste were directed to a landfill and decomposed under anaerobic conditions are avoided.  The combustion of this waste also displaces fossil fuel-generated electricity and instead generates a portion of Lee County's power demand from the waste stream..","location":{"latitude":26.634841,"longitude":-81.762913},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"290"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"FL"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Lee County Board of County Commissioners SW Div."},{"type":"string","value":"Zurich, Switzerland"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Verification approval requested"},{"type":"assetSearchLink","value":null,"targetId":"290"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"10864"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Energy industries (renewable/non-renewable sources)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0022"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"TÜV SÜD America Inc."}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"2nd, 18/08/2017 - 17/08/2027"}]}]}],"documentGroups":[{"c