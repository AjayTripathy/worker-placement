{"resourceIdentifier":"408","resourceName":"Thanawat wastewater treatment and biogas utilization project","description":"The project activity involves recovery of fugitive biogas from the wastewater released from the tapioca starch factory using an Upflow Anaerobic Sludge Blanket (UASB) system and covered lagoons and utilizing the biogas produced as fuel in the newly installed gas engine to produce electricity, thereby replacing the electricity from grid earlier used by the project participants. In addition, the generated biogas is used as a fuel in the boiler to produce thermal energy.","location":{"latitude":15.981389,"longitude":99.781667},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":null,"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"408"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Kamphaeng Phet,"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Thanawat Biogas Co., Ltd"},{"type":"string","value":"VT, United States"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Late to verify"},{"type":"assetSearchLink","value":null,"targetId":"408"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"22259"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-I.D.,AMS-III.H."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"TÜV NORD CERT GmbH"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"06/04/2020"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"CREDITING PERIOD HAS EXPIRED, 28/03/2006 - 27/03/2016"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[]},{"code":"VCS_ISSUANC