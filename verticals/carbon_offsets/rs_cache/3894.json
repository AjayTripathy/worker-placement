{"resourceIdentifier":"3894","resourceName":"SANTA MARIA LANDFILL GAS PROJECT","description":"The proposed VCS project activity titled “Santa Maria Landfill Gas Project” encompasses the promotion of collection and destruction/utilization of landfill gas (LFG) (rich in methane) at the previously existent landfill site (hereby termed “CTR Santa Maria Landfill”) through collection LFG and its destruction in high temperature enclosed flare(s) and utilization as gaseous fuel in set of engine-generator sets of an electricity generation infrastructure (with final total combined nameplate installed capacity of 1 MW).","location":{"latitude":-29.660410,"longitude":-53.860700},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2023-10-10","endExclusive":"2023-11-10","endInclusive":"2023-11-09"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3894"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Santa Maria, RS"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Solvi Participações S.A."},{"type":"string","value":"São Paulo, Brazil"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Verification approval requested"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"101103"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"21/01/2025"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 20/10/2022 - 19/10/2029"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/Proje