{"resourceIdentifier":"3969","resourceName":"Hebei Handan Damingchang Biogas Recovery and Utilization Project","description":"Hebei Handan Damingchang Biogas Recovery and Utilization Project (hereinafter referred to as the Project) locates in Cao Ren Village, Dangtou Township, Daming County, Handan City, Hebei Province, P.R China. The project is to build a centralized anaerobic animal manure treatment system which collects manure waste from dairy cows from Daming farms in Daming County. The project uses animal manure waste as ferment material to produce biogas in the Completely Stirred Tank Reactor (CSTR) type anaerobic digesters. The recovered biogas will be used for electricity generation at the project site. The electricity generated by the project will be delivered to North China Power Grid (NCPG). The residual waste from the CSTR digesters will be used to produce organic fertilizer at the project site.\r\nThe project is expected to avoid GHG emission of methane through recovery and destruction of biogas. In addition, the electricity generated from the biogas will be delivered to NCPG to replace equivalent electricity generated by the fossil fuel fired power plants connected to the grid.","location":{"latitude":36.189000,"longitude":115.283445},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-12-13","endExclusive":"2023-01-13","endInclusive":"2023-01-12"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3969"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Heibei"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Daming Jiujin Energy Co., Ltd"},{"type":"string","value":"Hebei Province, China"},{"type":"string","value":"3542346576@qq.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"33017"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-I.D.,AMS-III.D."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"China Classification Society Certification Company (CCSC)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"04/07/2024"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 26/08/2022 - 25/08/2029"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=80668&IDKEY=0lksjoiuwqowrnoiuomnckjashoufifmln902309ksdflku098o111241172","documentType":"Draft Project Description","documentName":"VCS_PROJ_DESC_PCP_3969_08NOV2022.pdf","uploadDate":"2022-12-13T22:49:10.29Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=79459&IDKEY=siofj09234rm9oq4jndsma80vcalksdjf98cxkjaf90823nmq3d109573961","documentType":"Listing Representation","documentName":"03-Damingchang_VCS-Listing-Representation.pdf","uploadDate":"2022-11-25T13:31:02.797Z"}]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=115376&IDKEY=jq934lkmsad39asjdkfj90qlkalsdkngaf98ulkandDfdvDdfhn159103504","documentType":"Project Description","documentName":"Damingchang_VCSB PDB v2.0-clean.pdf","uploadDate":"2024-07-04T21:59:07.903Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=88578&IDKEY=a98klasmf8jflkasf8098afnasfkj98f0a9sfsakjflsakjf8ds122149062","documentType":"Registration Representation","documentName":"06-Damingchang_VCS-Registration-Representation-v4.2.pdf","uploadDate":"2023-04-19T09:54:34.35Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=115378&IDKEY=3iquwesdfmnk0iei23nnm435oioj