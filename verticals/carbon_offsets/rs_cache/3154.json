{"resourceIdentifier":"3154","resourceName":"Household Biogas Project in Uttarakhand, India","description":"The project activity involves operation of 13,549 household biogas plants (biodigesters) in Uttarakhand. Almost all Biodigesters are of 3m3 capacity. The plants covered under the project activity are commissioned from 22nd September 2020 onwards. The biogas plants are of deenbandhu model. The purpose of the project is to replace the commonly used inefficient wood fired mud stoves technology, with clean, sustainable, and efficient biogas. Each household utilizes cow dung to feed the digester to produce biogas for cooking purpose and heating water. This leads to reduction of greenhouse gas emissions by displacing conventionally used nonrenewable biomass with renewable biogas. In addition, the hygienic conditions in the rural areas will be improved by an appropriate disposal of organic waste. Further, residue from the bio digesters can be used as organic fertilizer and will improve soil conditions in rural areas leading to increase in soil productivity. Project activity will contribute towards sustainable development by replacing nonrenewable firewood with biogas generated from the bio digesters.","location":{"latitude":30.316500,"longitude":78.032200},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-08-18","endExclusive":"2022-09-18","endInclusive":"2022-09-17"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3154"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Uttarakhand"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Green Solutions"},{"type":"string","value":"Uttarakhand, India"},{"type":"string","value":"+91-9412127663"},{"type":"string","value":"greensolutions.mailbox@gmail.com"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3154"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"53673"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"AMS-I.E."}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"14/09/2023"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 22/09/2020 - 21/09/2027"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=65986&IDKEY=niofj09234rm9oq4jndsma80vcalksdjf98cxkjaf90823nmq3f90994694","documentType":"Draft Project Description","documentName":"Draft PDMR_Biogas UK.pdf","uploadDate":"2022-05-03T13:26:32.187Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=65983&IDKEY=9q934lkmsad39asjdkfj90qlkalsdkngaf98ulkandDfdvDdfhk90990557","documentType":"Listing Representation","documentName":"VCS-Listing-Representation-Single-Representor_Biogas UK.pdf","uploadDate":"2022-05-03T13:24:12.4Z"}]},{"code":"VCS_REGISTRATION_DOCUMENTS","description":"VCS Registration Documents","documents":[{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=97153&IDKEY=f903q4jsafkasjfu90amnmasdfkaidflnmdf9348r09dmfasdff133973987","documentType":"Project Description","documentName":"PDMR_3154_v06_cleaned.pdf","uploadDate":"2023-09-14T14:02:45.063Z"},{"uri":"https://registry.verra.org/mymodule/ProjectDoc/Project_ViewFile.asp?FileID=78951&IDKEY=K0e98hfalksuf098fnsdalfkjfoijmn4309JLKJFjlaksjfla9f108873429","documentType":"Registration Representation","documentName":"VCS-Registration-Representation-Single-Representor-v4.1_3154.pdf","uploadDate":"2022-11-16T15:35:35.09Z"},{"uri":"https://registry.verr