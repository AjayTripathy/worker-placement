{"resourceIdentifier":"2464","resourceName":"Nanning Landfill Gas Power Generation Project","description":"The project is located at Pingli Landfill Site in Xingning District, Nanning City, Guangxi Zhuang Autonomous Region, P.R China. The project is a landfill gas collection and utilization project. The project will collect landfill gas (methane) and use it for electricity generation and the installed capacity is 5.8 MW. The power generated by plant is delivered to South China Power Grid. The annual power generation is expected to be 36,000 MWh. The annual emission reduction is expected to be 231,800 tons.","location":{"latitude":23.011942,"longitude":108.636386},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2021-03-16","endExclusive":"2021-04-16","endInclusive":"2021-04-15"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"2464"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Guangxi Zhuang Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Guangxi Ruirong Energy Technology Co., Ltd."},{"type":"string","value":"Guangxi Zhuang Autonomous Region, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"2464"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"231811"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Waste handling and disposal"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"24/06/2021"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 03/04/2020 - 02/04/2030"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS 