{"resourceIdentifier":"3626","resourceName":"Yangchun Landfill Gas Power Generation Project","description":"The purpose of the project is to use LFG, which consists mainly of methane, for electricity generation. It includes LFG collection system, LFG pre-treatment system, and electricity generation system.The total installed capacity of the project is 4MW, consisting of 8 sets of 500kW generator. The expected average annual emission reductions are 171,033 tCO2e and the total emission reductions are 1,197,231 tCO2e during the 7-year crediting period.","location":{"latitude":22.014721,"longitude":111.682500},"inPublicCommentPeriod":false,"lastPublicCommentPeriod":{"startInclusive":"2022-11-08","endExclusive":"2022-12-09","endInclusive":"2022-12-08"},"attributes":[{"code":"PROJECT_ID","values":[{"type":"string","value":"3626"}]},{"code":"STATE_PROVINCE","values":[{"type":"string","value":"Guangdong Province"}]}],"participationSummaries":[{"programCode":"VCS","attributes":[{"code":"PROPONENT_NAME","values":[{"type":"string","value":"Yangchun Huanchuang New Energy Co., Ltd."},{"type":"string","value":"Guangdong Province, China"}]},{"code":"PROJECT_STATUS","values":[{"type":"string","value":"Registered"},{"type":"assetSearchLink","value":null,"targetId":"3626"}]},{"code":"EST_ANNUAL_EMISSION_REDCT","values":[{"type":"string","value":"131612"}]},{"code":"PRIMARY_PROJECT_CATEGORY_NAME","values":[{"type":"string","value":"Energy industries (renewable/non-renewable sources)"}]},{"code":"PROTOCOL_NAME","values":[{"type":"string","value":"ACM0001"}]},{"code":"VALIDATOR_NAME","values":[{"type":"string","value":"LGAI Technological Center, S.A. (Applus+ Certification)"}]},{"code":"PROJECT_REGISTRATION_DATE","values":[{"type":"string","value":"21/06/2023"}]},{"code":"CREDIT_PERIOD_INFO","values":[{"type":"string","value":"1st, 10/08/2021 - 09/08/2028"}]}]}],"documentGroups":[{"code":"VCS_PIPELINE_DOCUMENTS","description":"VCS Pipeline Documents","documents":[{"uri":"https://registr