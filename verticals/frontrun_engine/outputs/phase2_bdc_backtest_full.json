 "summary": {
  "as_of": "2026-06-24",
  "test": "BDC spread/event-driven frontrun backtest (Arm-A properly-powered), PILOT_SPEC \u00a71/\u00a74/\u00a76/\u00a77, amendments A-1/A-2/A-4/A-5",
  "mechanism": {
   "masking_channel": "quarterly printed NAV with ~30-45d 10-Q filing lag; market trades on stale prior-quarter NAV during lag",
   "signal_channel": "derived NAV = re-mark last-printed floating-rate loan book for the HY-OAS credit-spread move (prior print -> quarter-end), models the OFFICIAL mark (smoothing 0.5, spread-duration 2.5y)",
   "signal_to_price_latency": "NONE capturable: BDC price reprices contemporaneously with the spread move, and at no greater rate than zero-credit equity CEFs (generic risk-off), so no spread-driven lag to frontrun"
  },
