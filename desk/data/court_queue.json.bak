    {
     "from": "COURT_RED",
     "to": "COURT_BLUE",
     "utc": "2026-08-17T18:52:32Z",
     "artifact": "/Users/ajay/exalted/signalos/desk/data/court_artifacts/TCPC_COURT_RED_202608171852.md",
