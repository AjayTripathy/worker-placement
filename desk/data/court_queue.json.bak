   "ticker": "TCPC",
   "stage": "KILLED",
   "source": "mark_integrity_study_20260817",
   "enqueued_utc": "2026-08-12T14:38:08Z",
   "screen_row": {
    "ticker": "TCPC",
    "dd52": -0.465,
    "sector": "Finance",
    "industry": "Finance/Investors Services",
    "mcap": 325542767.0,
    "excess_dd": -0.393,
    "context": "blob_sweep 2026-08-12: dd52 -0.465, excess vs Finance sector median -0.393 — cause-check FIRST, then refutability + court-worthiness score"
   },
   "history": [
    {
     "from": "REFUTABILITY",
     "to": "COURT_RED",
     "utc": "2026-08-17T03:33:52Z",
     "artifact": "/Users/ajay/exalted/signalos/desk/data/court_artifacts/TCPC_REFUTABILITY_202608170333.md",
     "note": null
