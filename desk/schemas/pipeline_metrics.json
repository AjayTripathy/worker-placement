{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pipeline_metrics store",
  "type": "object",
  "required": ["snapshots"],
  "properties": {
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "p1", "p3"],
        "properties": {
          "date": {"type": "string"},
          "p1": {"type": "object"},
          "p2": {"type": "object"},
          "p3": {"type": "object"},
          "cross": {"type": "object"}
        }
      }
    },
    "_meta": {"type": "object"}
  }
}
